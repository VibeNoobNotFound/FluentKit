@namespace FluentKit.Overlay
@implements IAsyncDisposable

<div class="fluent-overlay-surface @(Entry.Bare ? "fluent-overlay-surface--bare" : "") @(Entry.IsClosing ? "fluent-overlay-surface--closing" : "") @(Entry.IsPositioned ? "fluent-overlay-surface--positioned" : "") @(Entry.SurfaceOptions.ContentLayout == OverlayContentLayout.EdgeToEdge ? "fluent-overlay-surface--edge-to-edge" : "") @(Entry.SurfaceOptions.EntranceOrigin == OverlayEntranceOrigin.Top ? "fluent-overlay-surface--entrance-top" : Entry.SurfaceOptions.EntranceOrigin == OverlayEntranceOrigin.Center ? "fluent-overlay-surface--entrance-center" : Entry.SurfaceOptions.EntranceOrigin == OverlayEntranceOrigin.Bottom ? "fluent-overlay-surface--entrance-bottom" : "")" style="@Entry.ComputedStyle" @ref="_surfaceElement">
    @if (Entry.LightDismiss)
    {
        <div class="fluent-overlay-dismiss-backdrop" @onclick="() => OnLightDismiss(Entry.Id.ToString())"></div>
    }
    @if (!Entry.Bare)
    {
        <div class="fluent-overlay-surface-material" aria-hidden="true"></div>
    }
    <div class="fluent-overlay-surface-content">
        @Entry.Content
    </div>
</div>
