@namespace FluentKit.Composite
@implements IDisposable

<span @ref="_anchor" class="fluent-flyout-trigger" @onclick="ToggleAsync">
    @ChildContent
</span>

@code {
    // Declared here (not in the .cs code-behind) on purpose: CSS isolation only scopes markup that's
    // physically written in a .razor file. A RenderFragment built via RenderTreeBuilder in plain C#
    // never gets the scope attribute, so its styles in FluentFlyout.razor.css would silently not apply.
    private RenderFragment RenderFlyoutContent => @<div class="fluent-flyout-content" @onkeydown="HandleContentKeyDown">
        @FlyoutContent
    </div>;
}
