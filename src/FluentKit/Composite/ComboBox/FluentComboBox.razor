@namespace FluentKit.Composite
@typeparam TValue

<div @ref="_rootElement"
     class="fluent-combo-box @(Disabled ? "fluent-combo-box--disabled" : null) @(Editable ? "fluent-combo-box--editable" : null) @(_open ? "fluent-combo-box--open" : null)"
     @onkeydown="OnKeyDownAsync"
     @attributes="AdditionalAttributes">

    @if (Editable)
    {
        <div class="fluent-combo-box-textbox-container @(Disabled ? "fluent-combo-box-textbox-container--disabled" : null)">
            <input class="fluent-combo-box-textbox"
                   type="text"
                   role="combobox"
                   aria-autocomplete="both"
                   aria-controls="@DropdownId"
                   aria-expanded="@AriaExpanded"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   value="@SearchValue"
                   @oninput="OnSearchInputAsync"
                   @onfocus="OpenDropdown" />
            <span class="fluent-combo-box-textbox-underline" aria-hidden="true"></span>
            <button type="button"
                    class="fluent-combo-box-dropdown-button"
                    aria-label="Open dropdown"
                    aria-controls="@DropdownId"
                    aria-expanded="@AriaExpanded"
                    disabled="@Disabled"
                    @onclick="ToggleOpenAsync">
                <FluentIcon Name="@FluentIconNames.ChevronDown" Size="12" />
            </button>
        </div>
    }
    else
    {
        <button type="button"
                class="fluent-combo-box-button"
                aria-haspopup="listbox"
                aria-controls="@DropdownId"
                aria-expanded="@AriaExpanded"
                disabled="@Disabled"
                @onclick="ToggleOpenAsync">
            <span class="fluent-combo-box-label @(Selection is null ? "fluent-combo-box-label--placeholder" : null)">
                @if (Selection is not null && SelectedTemplate is not null)
                {
                    @SelectedTemplate(Selection)
                }
                else
                {
                    @(Selection?.Name ?? Placeholder)
                }
            </span>
            <FluentIcon Name="@FluentIconNames.ChevronDown" Size="12" />
        </button>
    }
</div>

@code {
    // The fragment is invoked by FluentOverlayHost. Keeping it in Razor retains the component's
    // CSS-isolation scope attributes after the render-tree portal hop.
    private RenderFragment RenderDropdown => @<ul id="@DropdownId"
                                                class="fluent-combo-box-dropdown-list"
                                                role="listbox"
                                                tabindex="-1"
                                                @onkeydown="OnKeyDownAsync">
        @foreach (var item in Items)
        {
            var isSelected = Selection is not null && EqualityComparer<TValue>.Default.Equals(item.Value, Selection.Value);
            <li class="fluent-combo-box-item @(isSelected ? "fluent-combo-box-item--selected" : null) @(item.Disabled ? "fluent-combo-box-item--disabled" : null)"
                role="option"
                aria-selected="@isSelected"
                tabindex="0"
                @onmousedown:preventDefault="true"
                @onclick="() => SelectAsync(item)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    <span>@item.Name</span>
                }
            </li>
        }
    </ul>;
}
