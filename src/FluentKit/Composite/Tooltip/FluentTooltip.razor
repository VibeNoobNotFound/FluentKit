@namespace FluentKit.Composite
@implements IDisposable

<span @ref="_anchor"
      @onmouseenter="ShowAsync"
      @onmouseleave="Hide"
      @onfocusin="ShowAsync"
      @onfocusout="Hide">
    @ChildContent
</span>

@code {
    // Declared here (not in the .cs code-behind) on purpose: CSS isolation only scopes markup that's
    // physically written in a .razor file. A RenderFragment built via RenderTreeBuilder in plain C#
    // never gets the scope attribute, so its styles in FluentTooltip.razor.css would silently not apply.
    private RenderFragment TooltipContent => @<span class="fluent-tooltip-text">@Text</span>;
}
