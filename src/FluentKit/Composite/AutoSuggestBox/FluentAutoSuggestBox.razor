@namespace FluentKit.Composite
@typeparam TValue
@using FluentKit.Primitives

<div @ref="_rootElement"
     class="fluent-autosuggest-root"
     @onkeydown="OnKeyDownAsync"
     @onfocusin="OnFocusIn"
     @onfocusout="OnFocusLost">

    <FluentTextBox Header="@Header"
                   Placeholder="@Placeholder"
                   Disabled="@Disabled"
                   Value="@Text"
                   ValueChanged="OnTextChangedAsync"
                   @attributes="TextBoxAttributes"><Buttons>@if (EnableSearchIcon)
{
    @if (!string.IsNullOrEmpty(Text))
    {
        <FluentTextBoxButton Disabled="@Disabled" OnClick="ClearAsync">
            <FluentIcon Name="@FluentIconNames.Dismiss" Size="16" />
        </FluentTextBoxButton>
    }
    else
    {
        <FluentTextBoxButton Disabled="true">
            <FluentIcon Name="@FluentIconNames.Search" Size="16" />
        </FluentTextBoxButton>
    }
}</Buttons></FluentTextBox>
</div>

@code {
    // Rendered by FluentOverlayHost; keeping it as a Razor fragment preserves component-scoped CSS.
    private RenderFragment RenderDropdown => @<ul @ref="_dropdownElement"
                                                id="@DropdownId"
                                                class="fluent-autosuggest-dropdown-list"
                                                role="listbox"
                                                tabindex="-1"
                                                @onkeydown="OnKeyDownAsync">
        @for (var i = 0; i < DisplayMatches.Count; i++)
        {
            var item = DisplayMatches[i];
            var isHighlighted = i == _highlightedIndex;
            <li class="fluent-autosuggest-item @(isHighlighted ? "fluent-autosuggest-item--highlighted" : null) @(item.Disabled ? "fluent-autosuggest-item--disabled" : null)"
                role="option"
                aria-selected="@isHighlighted"
                @onmousedown:preventDefault="true"
                @onclick="() => ChooseAsync(item)">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    <span>@item.Name</span>
                }
            </li>
        }
    </ul>;
}
