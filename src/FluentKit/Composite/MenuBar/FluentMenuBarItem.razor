@namespace FluentKit.Composite

<li class="fluent-menu-bar-item @(Disabled ? "fluent-menu-bar-item--disabled" : null)"
    role="menuitem"
    tabindex="@(Disabled ? -1 : 0)"
    aria-expanded="@(Flyout is not null && !Disabled && Open)"
    aria-haspopup="@(Flyout is not null)"
    @ref="_element"
    @onmousedown="ToggleAsync"
    @onmouseenter="OnMouseEnter"
    @onfocus="OnFocus"
    @onkeydown="OnKeyDown"
    @attributes="AdditionalAttributes">
    @ChildContent
</li>

@code {
    // Same CascadingValue re-wrap reasoning as FluentMenuFlyout/FluentMenuFlyoutItem: this fragment
    // is portalled to FluentOverlayHost via OverlayService.Show, so _closeContext has to be
    // (re)established here, at the point the fragment actually renders.
    private RenderFragment RenderFlyoutContent => @<CascadingValue Value="_closeContext">
        <div @onkeydown="HandleFlyoutKeyDown">
            <FluentMenuFlyoutSurface>@Flyout</FluentMenuFlyoutSurface>
        </div>
    </CascadingValue>;
}
