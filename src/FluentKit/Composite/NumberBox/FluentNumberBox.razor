@namespace FluentKit.Composite
@using FluentKit.Primitives

<div class="fluent-numberbox-root">
    <FluentTextBox Header="@Header"
                   Placeholder="@Placeholder"
                   Disabled="@Disabled"
                   Value="@DisplayValue"
                   ValueChanged="OnTextChangedAsync"
                   Type="text"
                   @attributes="AdditionalAttributes"><Buttons>@if (Mode == NumberBoxSpinButtonMode.Compact)
{
    <div class="fluent-numberbox-compact">
        <FluentTextBoxButton Disabled="@(Disabled || AtMin)" OnClick="StepDownAsync">
            <FluentIcon Name="@FluentIconNames.Subtract" Size="12" />
        </FluentTextBoxButton>
        <FluentTextBoxButton Disabled="@(Disabled || AtMax)" OnClick="StepUpAsync">
            <FluentIcon Name="@FluentIconNames.Add" Size="12" />
        </FluentTextBoxButton>
    </div>
}</Buttons></FluentTextBox>

    @if (Mode == NumberBoxSpinButtonMode.Expanded)
    {
        <div class="fluent-numberbox-popout" aria-hidden="@(Disabled ? "true" : "false")">
            <FluentTextBoxButton Disabled="@(Disabled || AtMax)" OnClick="StepUpAsync">
                <FluentIcon Name="@FluentIconNames.ChevronUp" Size="14" />
            </FluentTextBoxButton>
            <FluentTextBoxButton Disabled="@(Disabled || AtMin)" OnClick="StepDownAsync">
                <FluentIcon Name="@FluentIconNames.ChevronDown" Size="14" />
            </FluentTextBoxButton>
        </div>
    }
</div>
