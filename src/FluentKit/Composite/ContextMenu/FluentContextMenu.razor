@namespace FluentKit.Composite
@implements IDisposable

<div class="fluent-context-menu-wrapper"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true"
     @oncontextmenu:stopPropagation="true"
     @attributes="AdditionalAttributes">
    @ChildContent

    <div style="@_anchorStyle" @ref="_cursorAnchor"></div>
</div>

@code {
    // Same CascadingValue re-wrap reasoning as FluentMenuFlyout.RenderMenuContent — this fragment is
    // portalled to FluentOverlayHost via OverlayService.Show, so _context must be re-established at
    // the point the fragment actually renders.
    private RenderFragment RenderMenuContent => @<CascadingValue Value="_context">
        <div @onkeydown="HandleContentKeyDown">
            <FluentMenuFlyoutSurface>@MenuItems</FluentMenuFlyoutSurface>
        </div>
    </CascadingValue>;
}
