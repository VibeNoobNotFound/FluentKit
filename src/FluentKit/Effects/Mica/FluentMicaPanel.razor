@namespace FluentKit.Effects

<div class="fluent-mica @VariantClass" @attributes="AdditionalAttributes">
    @if (_renderedImageUrl is not null)
    {
        <div class="fluent-mica__wallpaper" style="background-image:url('@_renderedImageUrl')" aria-hidden="true"></div>
    }
    <div class="fluent-mica__content">
        @ChildContent
    </div>
</div>
