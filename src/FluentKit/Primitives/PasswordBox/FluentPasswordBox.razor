@namespace FluentKit.Primitives

<FluentTextBox Value="@Value"
               ValueChanged="OnValueChanged"
               Header="@Header"
               Placeholder="@Placeholder"
               Type="@(_revealed ? "text" : "password")"
               Disabled="Disabled"
               @attributes="AdditionalAttributes">
    <Buttons>
        <FluentTextBoxButton Disabled="Disabled" OnClick="ToggleRevealAsync">
            <FluentIcon Name="@(_revealed ? FluentIconNames.EyeOff : FluentIconNames.Eye)" />
        </FluentTextBoxButton>
    </Buttons>
</FluentTextBox>
