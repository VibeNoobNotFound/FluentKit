@namespace FluentKit.Primitives

<label class="fluent-radio-container" @onclick="SelectAsync">
    @if (ItemTemplate is not null)
    {
        <span role="radio"
              aria-checked="@(IsSelected ? "true" : "false")"
              aria-disabled="@(Disabled ? "true" : "false")"
              tabindex="@(Disabled ? "-1" : "0")"
              @onkeydown="OnKeyDownAsync"
              @attributes="AdditionalAttributes">
            @ItemTemplate(IsSelected)
        </span>
    }
    else
    {
        <span class="fluent-radio @(IsSelected ? "fluent-radio--checked" : null)"
              role="radio"
              aria-checked="@(IsSelected ? "true" : "false")"
              aria-disabled="@(Disabled ? "true" : "false")"
              tabindex="@(Disabled ? "-1" : "0")"
              @onkeydown="OnKeyDownAsync"
              @attributes="AdditionalAttributes">
            @if (IsSelected)
            {
                <span class="fluent-radio__dot" aria-hidden="true"></span>
            }
        </span>
        @if (ChildContent is not null)
        {
            <span class="fluent-radio-label">@ChildContent</span>
        }
    }
</label>
