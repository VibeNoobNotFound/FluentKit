@namespace FluentKit.Primitives

<button type="button"
        @ref="_element"
        class="fluent-list-view-item @(Selected ? "fluent-list-view-item--selected" : "") @(AutoHeight ? "fluent-list-view-item--auto-height" : "")"
        disabled="@Disabled"
        role="listitem"
        aria-selected="@Selected"
        @onclick="HandleClickAsync"
        @onkeydown="HandleKeyDownAsync"
        @attributes="AdditionalAttributes">
    <span class="fluent-list-view-item-indicator" aria-hidden="true"></span>
    @if (ShowCheckmark)
    {
        <span class="fluent-list-view-item-checkbox @(Selected ? "fluent-list-view-item-checkbox--checked" : "")" aria-hidden="true">
            <svg class="fluent-list-view-item-checkbox__glyph" viewBox="0 0 24 24">
                <path d="M 4.5303 12.9697 L 8.5 16.9393 L 18.9697 6.4697" fill="none" />
            </svg>
        </span>
    }
    @ChildContent
</button>
