@namespace FluentKit.Primitives
@inherits FluentKit.Common.SizableComponentBase

@if (IsLink)
{
    <a class="fluent-button @VariantClass"
       href="@(Disabled ? null : Href)"
       target="@Target"
       rel="@(IsExternalTarget ? "noopener noreferrer" : null)"
       aria-disabled="@(Disabled ? "true" : null)"
       tabindex="@(Disabled ? "-1" : null)"
       style="@SizingStyle"
       @onclick="OnClick"
       @onclick:preventDefault="Disabled"
       @attributes="AdditionalAttributes">
        @ChildContent
    </a>
}
else
{
    <button type="button"
            class="fluent-button @VariantClass"
            disabled="@Disabled"
            style="@SizingStyle"
            @onclick="OnClick"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}
