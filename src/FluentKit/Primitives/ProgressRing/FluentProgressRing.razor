@namespace FluentKit.Primitives

<svg class="fluent-progress-ring @(IsIndeterminate ? "indeterminate" : "")"
     tabindex="-1"
     width="@Size"
     height="@Size"
     viewBox="0 0 16 16"
     role="@(IsIndeterminate ? "status" : "progressbar")"
     aria-valuemin="@(IsIndeterminate ? null : 0)"
     aria-valuemax="@(IsIndeterminate ? null : 100)"
     aria-valuenow="@(IsIndeterminate ? null : ClampedValue)"
     @attributes="AdditionalAttributes">
    <circle cx="50%"
            cy="50%"
            r="7"
            stroke-dashoffset="@(IsIndeterminate ? null : DashOffset)" />
</svg>
