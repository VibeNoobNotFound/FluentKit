@namespace FluentKit.Primitives

<div class="fluent-textbox-root">
    @if (!string.IsNullOrEmpty(Header))
    {
        <span class="fluent-textbox-header">@Header</span>
    }
    <div class="fluent-textbox-container @(Disabled ? "fluent-textbox-container--disabled" : null)">
        <input class="fluent-textbox"
               type="@Type"
               value="@Value"
               placeholder="@Placeholder"
               disabled="@Disabled"
               @oninput="OnInputAsync"
               @attributes="AdditionalAttributes" />
        <span class="fluent-textbox-underline" aria-hidden="true"></span>
        @if (Buttons is not null)
        {
            <div class="fluent-textbox-buttons">
                @Buttons
            </div>
        }
    </div>
</div>
