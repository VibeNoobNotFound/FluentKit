@namespace FluentKit.Primitives

<label class="fluent-checkbox-container" @onclick="ToggleAsync">
    <span class="fluent-checkbox @(Checked ? "fluent-checkbox--checked" : null) @(Indeterminate ? "fluent-checkbox--indeterminate" : null)"
          role="checkbox"
          aria-checked="@AriaChecked"
          aria-disabled="@(Disabled ? "true" : "false")"
          tabindex="@(Disabled ? "-1" : "0")"
          @onkeydown="OnKeyDownAsync"
          @attributes="AdditionalAttributes">
        <svg class="fluent-checkbox__glyph" viewBox="0 0 24 24" aria-hidden="true">
            <path class="fluent-checkbox__checkmark"
                  d="M 4.5303 12.9697 L 8.5 16.9393 L 18.9697 6.4697"
                  fill="none" />
        </svg>
        <span class="fluent-checkbox__dash" aria-hidden="true"></span>
    </span>
    @if (ChildContent is not null)
    {
        <span class="fluent-checkbox-label">@ChildContent</span>
    }
</label>
