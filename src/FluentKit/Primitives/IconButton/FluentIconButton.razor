@namespace FluentKit.Primitives
@inherits FluentKit.Common.SizableComponentBase

@if (IsAnchor)
{
    <a role="button"
       href="@Href"
       class="fluent-icon-button @VariantClass"
       style="@SizingStyle"
       @onclick="OnClick"
       @attributes="AdditionalAttributes">
        @ChildContent
    </a>
}
else
{
    <button type="button"
            class="fluent-icon-button @VariantClass @(Disabled ? "fluent-icon-button--disabled" : null)"
            disabled="@Disabled"
            style="@SizingStyle"
            @onclick="OnClick"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}
