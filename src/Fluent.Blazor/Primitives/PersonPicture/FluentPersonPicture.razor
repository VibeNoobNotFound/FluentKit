@namespace Fluent.Blazor.Primitives

<div class="fluent-person-picture-container" style="--person-picture-size: @(Size)px">
    @if (ShowImage)
    {
        <img class="fluent-person-picture"
             width="@Size"
             height="@Size"
             src="@Src"
             alt="@Alt"
             @onerror="OnImageError"
             @attributes="AdditionalAttributes" />
    }
    else
    {
        <div class="fluent-person-picture" @attributes="AdditionalAttributes">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Initials
            }
        </div>
    }
    @if (Badge is not null)
    {
        <span class="fluent-person-picture-badge">
            @Badge
        </span>
    }
</div>
