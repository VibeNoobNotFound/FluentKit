@namespace Fluent.Blazor.Primitives

<div class="fluent-slider fluent-slider--@(OrientationArg) @(Disabled ? "fluent-slider--disabled" : "")"
     style="@ContainerStyle"
     @attributes="SplattedAttributes">

    <div class="fluent-slider-rail" @ref="_railElement" @onpointerdown="OnPointerDown">

        @if (Ticks is { } ticks && TickPlacement != FluentSliderTickPlacement.None)
        {
            <div class="fluent-slider-ticks fluent-slider-ticks--@(TickPlacement == FluentSliderTickPlacement.Inline ? "inline" : "outside")">
                @foreach (var tick in ticks)
                {
                    var tickPct = TickPercent(tick);
                    <span class="fluent-slider-tick" style="--slider-tick-percent:@(tickPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></span>
                }
            </div>
        }

        <div class="fluent-slider-track-fill"></div>

        <div class="fluent-slider-thumb"
             role="slider"
             tabindex="@(Disabled ? -1 : 0)"
             aria-valuemin="@Min"
             aria-valuemax="@Max"
             aria-valuenow="@ClampedValue"
             aria-orientation="@(IsVertical ? "vertical" : "horizontal")"
             aria-disabled="@(Disabled ? "true" : null)"
             @onkeydown="OnKeyDown"
             @onmouseenter="@(() => _hovering = true)"
             @onmouseleave="@(() => _hovering = false)"
             @onfocus="@(() => _focused = true)"
             @onblur="@(() => _focused = false)">

            @if (ShowTooltipNow)
            {
                <div class="fluent-slider-tooltip">@DisplayValue</div>
            }
        </div>
    </div>
</div>
