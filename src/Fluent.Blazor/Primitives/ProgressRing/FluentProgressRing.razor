@namespace Fluent.Blazor.Primitives

<div class="fluent-progress-ring @(IsIndeterminate ? "fluent-progress-ring--indeterminate" : "")"
     role="progressbar"
     aria-valuemin="0"
     aria-valuemax="100"
     aria-valuenow="@(IsIndeterminate ? null : ClampedValue)"
     style="inline-size:@(Size)px; block-size:@(Size)px; @(IsIndeterminate ? "" : $"--fluent-progress-ring-angle:{ClampedValue * 3.6}deg;")"
     @attributes="AdditionalAttributes">
    <div class="fluent-progress-ring-mask"></div>
</div>
