@namespace Fluent.Blazor.Overlay
@implements IAsyncDisposable

<div class="fluent-overlay-surface @(Entry.Bare ? "fluent-overlay-surface--bare" : "") @(Entry.IsClosing ? "fluent-overlay-surface--closing" : "")" style="@Entry.ComputedStyle" @ref="_surfaceElement">
    @if (Entry.LightDismiss)
    {
        <div class="fluent-overlay-dismiss-backdrop" @onclick="() => OnLightDismiss(Entry.Id.ToString())"></div>
    }
    @if (!Entry.Bare)
    {
        <div class="fluent-overlay-surface-material" aria-hidden="true"></div>
    }
    <div class="fluent-overlay-surface-content">
        @Entry.Content
    </div>
</div>
