@namespace Fluent.Blazor.Composite

<FluentMenuFlyout @bind-IsOpen="IsOpen" MenuItems="MenuItems" Placement="Placement" MatchAnchorWidth="true">
    <div class="fluent-splitbutton @VariantClass">
        <button type="button"
                class="fluent-splitbutton-action"
                disabled="@Disabled"
                @onclick="OnClick"
                @onclick:stopPropagation="true"
                @attributes="AdditionalAttributes">
            @ChildContent
        </button>
        <button type="button" class="fluent-splitbutton-chevron" disabled="@Disabled" aria-label="More options">
            <FluentIcon Name="@FluentIconNames.ChevronDown" />
        </button>
    </div>
</FluentMenuFlyout>
