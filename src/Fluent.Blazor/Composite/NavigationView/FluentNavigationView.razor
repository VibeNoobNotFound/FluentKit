@namespace Fluent.Blazor.Composite
@implements IDisposable

<CascadingValue Value="_context" IsFixed="true">
    <div class="fluent-nav-view fluent-nav-view--@EffectivePaneDisplayModeClass"
         @attributes="AdditionalAttributes"
         @ref="_rootElement">

        @if (!IsCompactOrMinimal)
        {
            <!-- Expanded mode: pane is always visible, toggles width -->
            <aside class="fluent-nav-view-pane @(IsPaneOpen ? "fluent-nav-view-pane--open" : "")">
                <header class="fluent-nav-view-pane-header">
                    @if (ShowBackButton && IsPaneOpen)
                    {
                        <button type="button" class="fluent-nav-view-nav-button" @onclick="OnBackClick" aria-label="Back">
                            <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                        </button>
                    }
                    <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Toggle navigation pane">
                        <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                    </button>
                    @PaneHeader
                </header>
                <div class="fluent-nav-view-pane-items-wrapper">
                    <div class="fluent-nav-view-pane-items" role="list">
                        @MenuItems
                    </div>
                </div>
                <footer class="fluent-nav-view-pane-footer">
                    @PaneFooter
                    @if (ShowSettingsButton)
                    {
                        <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-settings-button" @onclick="OnSettingsClick" aria-label="Settings">
                            <FluentIcon Name="ic_fluent_settings_20_regular" Size="16" />
                            @if (IsPaneOpen)
                            {
                                <span>Settings</span>
                            }
                        </button>
                    }
                </footer>
            </aside>
        }
        else
        {
            if (IsPaneOpen)
            {
                <!-- Overlay mode: full pane overlay (no rail) -->
                <div class="fluent-nav-view-pane-overlay fluent-nav-view-pane-overlay--open">
                    <header class="fluent-nav-view-pane-header">
                        @if (ShowBackButton)
                        {
                            <button type="button" class="fluent-nav-view-nav-button" @onclick="OnBackClick" aria-label="Back">
                                <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                            </button>
                        }
                        <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Toggle navigation pane">
                            <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                        </button>
                        @PaneHeader
                    </header>
                    <div class="fluent-nav-view-pane-items-wrapper">
                        <div class="fluent-nav-view-pane-items" role="list">
                            @MenuItems
                        </div>
                    </div>
                    <footer class="fluent-nav-view-pane-footer">
                        @PaneFooter
                        @if (ShowSettingsButton)
                        {
                            <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-settings-button" @onclick="OnSettingsClick" aria-label="Settings">
                                <FluentIcon Name="ic_fluent_settings_20_regular" Size="16" />
                                <span>Settings</span>
                            </button>
                        }
                    </footer>
                </div>
            }
            else
            {
                <!-- Rail mode: icon-only rail -->
                <aside class="fluent-nav-view-pane fluent-nav-view-pane--rail @(PaneDisplayMode == NavigationViewPaneDisplayMode.LeftMinimal ? "fluent-nav-view-pane--rail-minimal" : "")">
                    <header class="fluent-nav-view-pane-header fluent-nav-view-pane-header--rail">
                        <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-nav-button--rail" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                            <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                        </button>
                    </header>
                    <div class="fluent-nav-view-pane-items-wrapper">
                        <div class="fluent-nav-view-pane-items" role="list">
                            @MenuItems
                        </div>
                    </div>
                    <footer class="fluent-nav-view-pane-footer">
                        @if (ShowSettingsButton)
                        {
                            <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-nav-button--rail fluent-nav-view-settings-button" @onclick="OnSettingsClick" aria-label="Settings">
                                <FluentIcon Name="ic_fluent_settings_20_regular" Size="16" />
                            </button>
                        }
                    </footer>
                </aside>
            }
        }

        <div class="fluent-nav-view-content @(PaneDisplayMode == NavigationViewPaneDisplayMode.LeftMinimal && !IsPaneOpen ? "fluent-nav-view-content--minimal-closed" : "")">
            @if (PaneDisplayMode == NavigationViewPaneDisplayMode.LeftMinimal && !IsPaneOpen)
            {
                <div class="fluent-nav-view-content-top-bar">
                    @if (ShowBackButton)
                    {
                        <button type="button" class="fluent-nav-view-nav-button" @onclick="OnBackClick" aria-label="Back">
                            <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                        </button>
                    }
                    <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                        <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                    </button>
                    @if (HeaderContent is not null)
                    {
                        <span class="fluent-nav-view-content-title">@HeaderContent</span>
                    }
                </div>
            }
            else if (AlwaysShowHeader || IsPaneOpen || PaneDisplayMode == NavigationViewPaneDisplayMode.Top)
            {
                <header class="fluent-nav-view-header">
                    @HeaderContent
                </header>
            }
            <main class="fluent-nav-view-main">
                @ChildContent
            </main>
        </div>
    </div>
</CascadingValue>

@code {
    private string EffectivePaneDisplayModeClass
    {
        get
        {
            // When in compact/minimal and pane is open, we switch to minimal mode
            // so the overlay shows labels properly.
            if (IsCompactOrMinimal && IsPaneOpen)
            {
                return "minimal";
            }
            return PaneDisplayModeClass;
        }
    }
}