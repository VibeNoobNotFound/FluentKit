@namespace Fluent.Blazor.Composite
@implements IDisposable

<CascadingValue Value="_context" IsFixed="true">
    <div class="fluent-nav-view fluent-nav-view--@EffectivePaneDisplayModeClass"
         @attributes="AdditionalAttributes"
         @ref="_rootElement">

        @if (PaneDisplayMode == NavigationViewPaneDisplayMode.Left)
        {
            @* Left mode: single persistent aside that animates between rail (closed) and full
               (open) by toggling --open / --rail CSS classes. Keeping the element in the DOM
               across both states lets the inline-size CSS transition fire; if we swapped between
               two @if branches the element would be destroyed and recreated, so there would be
               nothing to transition from. *@
            <aside class="fluent-nav-view-pane @(IsPaneOpen ? "fluent-nav-view-pane--open" : "fluent-nav-view-pane--rail")">
                <header class="fluent-nav-view-pane-header @(!IsPaneOpen ? "fluent-nav-view-pane-header--rail" : "")">
                    @if (IsPaneOpen)
                    {
                        @* Expanded header: buttons row on top, optional custom header below *@
                        <div class="fluent-nav-view-pane-header-buttons">
                            @if (ShowBackButton)
                            {
                                <button type="button" class="fluent-nav-view-nav-button" @onclick="OnBackClick" aria-label="Back">
                                    <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                                </button>
                            }
                            <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Toggle navigation pane">
                                <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                            </button>
                        </div>
                        @if (PaneHeader is not null)
                        {
                            <div class="fluent-nav-view-pane-custom-header">
                                @PaneHeader
                            </div>
                        }
                    }
                    else
                    {
                        @* Rail header: back button stacked above hamburger, same as compact rail *@
                        @if (ShowBackButton)
                        {
                            <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-nav-button--rail" @onclick="OnBackClick" aria-label="Back">
                                <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                            </button>
                        }
                        <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-nav-button--rail" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                            <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                        </button>
                    }
                </header>
                <div class="fluent-nav-view-pane-items-wrapper">
                    <div class="fluent-nav-view-pane-items" role="list">
                        @if (!IsPaneOpen && PaneHeaderIcon is not null)
                        {
                            @* Show PaneHeaderIcon as a tappable button in the rail — same as compact *@
                            <button type="button" class="fluent-nav-view-pane-header-icon-button" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                                @PaneHeaderIcon
                            </button>
                        }
                        @MenuItems
                    </div>
                </div>
                <footer class="fluent-nav-view-pane-footer">
                    @if (IsPaneOpen)
                    {
                        @PaneFooter
                    }
                    @if (ShowSettingsButton)
                    {
                        <FluentNavigationViewItem Value="@FluentNavigationView.SettingsItemValue" Text="Settings">
                            <Icon><FluentIcon Name="ic_fluent_settings_20_regular" Size="16" /></Icon>
                        </FluentNavigationViewItem>
                    }
                </footer>
            </aside>
        }
        else if (!IsCompactOrMinimal)
        {
            @* Auto / Top: pane is always visible, toggles width *@
            <aside class="fluent-nav-view-pane @(IsPaneOpen ? "fluent-nav-view-pane--open" : "")">
                <header class="fluent-nav-view-pane-header">
                    <div class="fluent-nav-view-pane-header-buttons">
                        @if (ShowBackButton && IsPaneOpen)
                        {
                            <button type="button" class="fluent-nav-view-nav-button" @onclick="OnBackClick" aria-label="Back">
                                <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                            </button>
                        }
                        <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Toggle navigation pane">
                            <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                        </button>
                    </div>
                    @if (PaneHeader is not null && IsPaneOpen)
                    {
                        <div class="fluent-nav-view-pane-custom-header">
                            @PaneHeader
                        </div>
                    }
                </header>
                <div class="fluent-nav-view-pane-items-wrapper">
                    <div class="fluent-nav-view-pane-items" role="list">
                        @MenuItems
                    </div>
                </div>
                <footer class="fluent-nav-view-pane-footer">
                    @PaneFooter
                    @if (ShowSettingsButton)
                    {
                        <FluentNavigationViewItem Value="@FluentNavigationView.SettingsItemValue" Text="Settings">
                            <Icon><FluentIcon Name="ic_fluent_settings_20_regular" Size="16" /></Icon>
                        </FluentNavigationViewItem>
                    }
                </footer>
            </aside>
        }
        else
        {
            @* Compact / Minimal: icon-only rail always mounted alongside the overlay.
               The overlay is always kept in the DOM (never swapped via @if) so the
               CSS translateX transition has a "closed" frame to animate from; an element
               that's freshly created already open has no closed frame and snaps. *@
            <aside class="fluent-nav-view-pane fluent-nav-view-pane--rail @(PaneDisplayMode == NavigationViewPaneDisplayMode.LeftMinimal ? "fluent-nav-view-pane--rail-minimal" : "")">
                <header class="fluent-nav-view-pane-header fluent-nav-view-pane-header--rail">
                    @if (ShowBackButton)
                    {
                        <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-nav-button--rail" @onclick="OnBackClick" aria-label="Back">
                            <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                        </button>
                    }
                    <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-nav-button--rail" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                        <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                    </button>
                </header>
                <div class="fluent-nav-view-pane-items-wrapper">
                    <div class="fluent-nav-view-pane-items" role="list">
                        @if (PaneHeaderIcon is not null)
                        {
                            <button type="button" class="fluent-nav-view-pane-header-icon-button" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                                @PaneHeaderIcon
                            </button>
                        }
                        @MenuItems
                    </div>
                </div>
                <footer class="fluent-nav-view-pane-footer">
                    @if (ShowSettingsButton)
                    {
                        <FluentNavigationViewItem Value="@FluentNavigationView.SettingsItemValue" Text="Settings">
                            <Icon><FluentIcon Name="ic_fluent_settings_20_regular" Size="16" /></Icon>
                        </FluentNavigationViewItem>
                    }
                </footer>
            </aside>

            @if (IsPaneOpen)
            {
                <div class="fluent-nav-view-dismiss-backdrop" @onclick="TogglePaneAsync"></div>
            }

            <div class="fluent-nav-view-pane-overlay @(IsPaneOpen ? "fluent-nav-view-pane-overlay--open" : "")"
                 aria-hidden="@(!IsPaneOpen)">
                @* Material div painted first; real content wrapper painted after it in DOM order
                   (guaranteed above it without cross-sibling z-index tricks — backdrop-filter
                   compositing doesn't reliably honor z-index against later siblings). *@
                <div class="fluent-nav-view-pane-overlay-material" aria-hidden="true"></div>
                <div class="fluent-nav-view-pane-overlay-content">
                    <header class="fluent-nav-view-pane-header">
                        <div class="fluent-nav-view-pane-header-buttons">
                            @if (ShowBackButton)
                            {
                                <button type="button" class="fluent-nav-view-nav-button" @onclick="OnBackClick" aria-label="Back">
                                    <FluentIcon Name="ic_fluent_arrow_left_20_regular" Size="16" />
                                </button>
                            }
                            <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Toggle navigation pane">
                                <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                            </button>
                        </div>
                        @if (PaneHeader is not null)
                        {
                            <div class="fluent-nav-view-pane-custom-header">
                                @PaneHeader
                            </div>
                        }
                    </header>
                    <div class="fluent-nav-view-pane-items-wrapper">
                        <div class="fluent-nav-view-pane-items" role="list">
                            @MenuItems
                        </div>
                    </div>
                    <footer class="fluent-nav-view-pane-footer">
                        @PaneFooter
                        @if (ShowSettingsButton)
                        {
                            <FluentNavigationViewItem Value="@FluentNavigationView.SettingsItemValue" Text="Settings">
                                <Icon><FluentIcon Name="ic_fluent_settings_20_regular" Size="16" /></Icon>
                            </FluentNavigationViewItem>
                        }
                    </footer>
                </div>
            </div>
        }

        <div class="fluent-nav-view-content @(PaneDisplayMode == NavigationViewPaneDisplayMode.LeftMinimal && !IsPaneOpen ? "fluent-nav-view-content--minimal-closed" : "")">
            @if (PaneDisplayMode == NavigationViewPaneDisplayMode.LeftMinimal && !IsPaneOpen)
            {
                <div class="fluent-nav-view-content-top-bar">
                    <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                        <FluentIcon Name="ic_fluent_navigation_20_regular" Size="16" />
                    </button>
                    @if (HeaderContent is not null)
                    {
                        <span class="fluent-nav-view-content-title">@HeaderContent</span>
                    }
                </div>
            }
            else if (AlwaysShowHeader || IsPaneOpen || PaneDisplayMode == NavigationViewPaneDisplayMode.Top)
            {
                <header class="fluent-nav-view-header">
                    @HeaderContent
                </header>
            }
            <main class="fluent-nav-view-main">
                @ChildContent
            </main>
        </div>
    </div>
</CascadingValue>

@code {
    private string EffectivePaneDisplayModeClass
    {
        get
        {
            // Compact/Minimal when open: restore full-label rendering inside the overlay
            if (IsCompactOrMinimal && IsPaneOpen) return "minimal";
            // Left mode when closed: apply compact CSS rules so items show icon-only (rail look)
            if (PaneDisplayMode == NavigationViewPaneDisplayMode.Left && !IsPaneOpen) return "compact";
            return PaneDisplayModeClass;
        }
    }
}