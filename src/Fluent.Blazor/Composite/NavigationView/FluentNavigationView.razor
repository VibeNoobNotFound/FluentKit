@namespace Fluent.Blazor.Composite
@using Fluent.Blazor.Effects
@using Fluent.Blazor.Primitives
@implements IDisposable

<CascadingValue Value="_context" IsFixed="false">
    <div class="fluent-nav-view fluent-nav-view--@PaneDisplayModeClass" @attributes="AdditionalAttributes">

        @if (!UsesOverlayPane)
        {
            <aside class="fluent-nav-view-pane @(IsPaneOpen ? "fluent-nav-view-pane--open" : "")">
                @PaneBody
            </aside>
        }
        else
        {
            <aside @ref="_railAnchor" class="fluent-nav-view-pane fluent-nav-view-pane--rail">
                @RailBody
            </aside>
        }

        <div class="fluent-nav-view-content">
            @ChildContent
        </div>
    </div>
</CascadingValue>

@code {
    // Declared here, not the .cs code-behind, so CSS isolation actually scopes these — same reason
    // as FluentTooltip: a RenderFragment built via RenderTreeBuilder in plain C# never gets the
    // scope attribute, so classes referenced only from these fragments would silently go unstyled.

    private RenderFragment PaneBody => @<text>
        <header class="fluent-nav-view-pane-header">
            @if (ShowBackButton)
            {
                <button type="button" class="fluent-nav-view-nav-button" @onclick="BackAsync" aria-label="Back">
                    <FluentIcon Name="@FluentIconNames.ArrowLeft" Size="16" />
                </button>
            }
            <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Toggle navigation pane">
                <FluentIcon Name="@FluentIconNames.Navigation" Size="16" />
            </button>
            @PaneHeader
        </header>
        <div class="fluent-nav-view-pane-items-wrapper">
            <FluentListView Role="list" Class="fluent-nav-view-pane-items">
                @MenuItems
            </FluentListView>
            @Indicator
        </div>
        <footer class="fluent-nav-view-pane-footer">
            @PaneFooter
            @if (ShowSettingsButton)
            {
                <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-settings-button" @onclick="OpenSettingsAsync" aria-label="Settings">
                    <FluentIcon Name="@FluentIconNames.Settings" Size="16" />
                    @if (IsLabelVisible)
                    {
                        <span>Settings</span>
                    }
                </button>
            }
        </footer>
    </text>;

    private RenderFragment RailBody => @<text>
        <header class="fluent-nav-view-pane-header">
            @if (ShowBackButton)
            {
                <button type="button" class="fluent-nav-view-nav-button" @onclick="BackAsync" aria-label="Back">
                    <FluentIcon Name="@FluentIconNames.ArrowLeft" Size="16" />
                </button>
            }
            <button type="button" class="fluent-nav-view-nav-button" @onclick="TogglePaneAsync" aria-label="Open navigation pane">
                <FluentIcon Name="@FluentIconNames.Navigation" Size="16" />
            </button>
            @PaneHeader
        </header>
        <div class="fluent-nav-view-pane-items-wrapper">
            <FluentListView Role="list" Class="fluent-nav-view-pane-items">
                @MenuItems
            </FluentListView>
            @Indicator
        </div>
        <footer class="fluent-nav-view-pane-footer">
            @PaneFooter
            @if (ShowSettingsButton)
            {
                <button type="button" class="fluent-nav-view-nav-button fluent-nav-view-settings-button" @onclick="OpenSettingsAsync" aria-label="Settings">
                    <FluentIcon Name="@FluentIconNames.Settings" Size="16" />
                </button>
            }
        </footer>
    </text>;

    private RenderFragment Indicator => @<span class="fluent-nav-view-indicator"
        style="@(_indicatorIndex >= 0 ? $"opacity:1;transform:translateY(calc({_indicatorIndex} * 42px + 12px));" : "opacity:0;")"
        aria-hidden="true"></span>;

    private RenderFragment PaneOverlayContent => @<div class="fluent-nav-view-pane-overlay">
        <FluentAcrylicBrush Kind="AcrylicKind.Base">
            @PaneBody
        </FluentAcrylicBrush>
    </div>;
}
