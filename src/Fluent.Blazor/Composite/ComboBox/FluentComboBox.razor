@namespace Fluent.Blazor.Composite
@typeparam TValue

<div @ref="_rootElement"
     class="fluent-combo-box @(Disabled ? "fluent-combo-box--disabled" : null) @(Editable ? "fluent-combo-box--editable" : null) @(_open ? "fluent-combo-box--open" : null)"
     @onkeydown="OnKeyDownAsync"
     @attributes="AdditionalAttributes">

    @if (Editable)
    {
        <div class="fluent-combo-box-textbox-container @(Disabled ? "fluent-combo-box-textbox-container--disabled" : null)">
            <input class="fluent-combo-box-textbox"
                   type="text"
                   role="combobox"
                   aria-autocomplete="both"
                   aria-expanded="@_open"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   value="@SearchValue"
                   @oninput="OnSearchInputAsync"
                   @onfocus="() => SetOpenAsync(true)" />
            <span class="fluent-combo-box-textbox-underline" aria-hidden="true"></span>
            <button type="button"
                    class="fluent-combo-box-dropdown-button"
                    aria-label="Open dropdown"
                    aria-expanded="@_open"
                    disabled="@Disabled"
                    @onclick="ToggleOpenAsync">
                <FluentIcon Name="@FluentIconNames.ChevronDown" Size="12" />
            </button>
        </div>
    }
    else
    {
        <button type="button"
                class="fluent-combo-box-button"
                aria-haspopup="listbox"
                aria-expanded="@_open"
                disabled="@Disabled"
                @onclick="ToggleOpenAsync">
            <span class="fluent-combo-box-label @(Selection is null ? "fluent-combo-box-label--placeholder" : null)">
                @if (Selection is not null && SelectedTemplate is not null)
                {
                    @SelectedTemplate(Selection)
                }
                else
                {
                    @(Selection?.Name ?? Placeholder)
                }
            </span>
            <FluentIcon Name="@FluentIconNames.ChevronDown" Size="12" />
        </button>
    }

    @if (!Disabled && Items.Count > 0 && _open)
    {
        @* .fluent-combo-box-dropdown is the outer, positioned/animated/clip-path-grown box (see
           .razor.css); the material div paints first, then the actual scrolling <ul> paints after
           it — content sits above the acrylic material by DOM/paint order, not cross-sibling
           z-index (same restructure as FluentAutoSuggestBox, see that file's comments). *@
        <div class="fluent-combo-box-dropdown fluent-combo-box-dropdown--@GrowDirectionClass"
             style="--fluent-combo-box-menu-offset: @(MenuOffsetPx)px;">
            <div class="fluent-combo-box-dropdown-material" aria-hidden="true"></div>
            <ul class="fluent-combo-box-dropdown-list"
                role="listbox"
                tabindex="-1"
                @onfocusout="OnFocusLostAsync">
                @foreach (var item in Items)
                {
                    var isSelected = Selection is not null && EqualityComparer<TValue>.Default.Equals(item.Value, Selection.Value);
                    <li class="fluent-combo-box-item @(isSelected ? "fluent-combo-box-item--selected" : null) @(item.Disabled ? "fluent-combo-box-item--disabled" : null)"
                        role="option"
                        aria-selected="@isSelected"
                        tabindex="0"
                        @onclick="() => SelectAsync(item)">
                        @if (ItemTemplate is not null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            <span>@item.Name</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>
