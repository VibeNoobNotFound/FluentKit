@namespace Fluent.Blazor.Composite

<li @ref="_itemElement"
    class="fluent-menu-flyout-item @VariantClass @(Cascading ? "fluent-menu-flyout-item--cascading" : "") @(Selected ? "fluent-menu-flyout-item--selected" : "") @(Checked ? "fluent-menu-flyout-item--checked" : "") @(Disabled ? "fluent-menu-flyout-item--disabled" : "") @(Indented ? "fluent-menu-flyout-item--indented" : "")"
    role="menuitem"
    tabindex="@(Disabled ? -1 : 0)"
    aria-disabled="@(Disabled ? "true" : null)"
    aria-selected="@((Selected || Checked) ? "true" : "false")"
    aria-haspopup="@(Cascading ? "true" : null)"
    aria-expanded="@(Cascading ? (SubmenuOpen ? "true" : "false") : null)"
    @onclick="ActivateAsync"
    @onkeydown="OnKeyDown"
    @onmouseenter="OnMouseEnter"
    @onmouseleave="OnMouseLeave"
    @attributes="AdditionalAttributes">

    @if (Variant == MenuFlyoutItemVariant.Radio)
    {
        <span class="fluent-menu-flyout-item-bullet"></span>
    }
    else if (Variant == MenuFlyoutItemVariant.Toggle)
    {
        <span class="fluent-menu-flyout-item-checkmark">
            @if (Checked)
            {
                <FluentIcon Name="@FluentIconNames.Checkmark" Size="12" />
            }
        </span>
    }
    else if (ShowIconGutter)
    {
        @* Reserve the leading gutter only when at least one item in this menu level actually has an
           icon (see MenuFlyoutIconGutterContext) — otherwise every label in an icon-free menu would
           sit indented for no reason. When it IS reserved, it's reserved even for items with no
           Icon of their own, so labels still line up with sibling items that do have one. *@
        <span class="fluent-menu-flyout-item-icon">@Icon</span>
    }

    <span class="fluent-menu-flyout-item-label">@ChildContent</span>

    @if (!string.IsNullOrEmpty(Hint))
    {
        <span class="fluent-menu-flyout-item-hint">@Hint</span>
    }

    @if (Cascading)
    {
        <span class="fluent-menu-flyout-item-arrow">
            <FluentIcon Name="@FluentIconNames.ChevronRight" Size="12" />
        </span>
    }
</li>

@code {
    // Declared here (not the .cs code-behind) so CSS isolation actually scopes it — see the
    // identical comment in FluentFlyout.razor for why a RenderTreeBuilder fragment built in plain
    // C# wouldn't pick up FluentMenuFlyoutItem.razor.css's scope attribute.
    //
    // The CascadingValue re-wrap here matters: OverlayService.Show portals this fragment to render
    // under FluentOverlayHost, nowhere near this item in the component tree, so the ambient
    // CloseContext this item received as its own [CascadingParameter] would NOT otherwise flow to
    // items inside the submenu — cascading values follow render-tree ancestry, not closure capture.
    private RenderFragment RenderSubmenuContent => @<CascadingValue Value="CloseContext">
        <FluentMenuFlyoutSurface>@Flyout</FluentMenuFlyoutSurface>
    </CascadingValue>;
}
