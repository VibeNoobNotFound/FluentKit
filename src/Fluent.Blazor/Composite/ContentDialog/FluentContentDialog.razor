@namespace Fluent.Blazor.Composite

@if (IsOpen)
{
    <div class="fluent-content-dialog-smoke @(Darken ? "fluent-content-dialog-smoke--darken" : null)"
         @onclick="OnBackdropClickAsync"
         @onkeydown="OnSmokeKeyDownAsync"
         tabindex="-1">
        <div class="fluent-content-dialog @SizeClass"
             role="dialog"
             aria-modal="true"
             aria-label="@Title"
             @onclick:stopPropagation="true"
             @attributes="AdditionalAttributes">
            <div class="fluent-content-dialog-body">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <FluentTextBlock Variant="TextBlockVariant.Subtitle" Class="fluent-content-dialog-title">@Title</FluentTextBlock>
                }
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <footer class="fluent-content-dialog-footer">
                    @Footer
                </footer>
            }
        </div>
    </div>
}
