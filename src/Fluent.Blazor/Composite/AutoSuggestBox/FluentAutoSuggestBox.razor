@namespace Fluent.Blazor.Composite
@typeparam TValue
@using Fluent.Blazor.Primitives

<div class="fluent-autosuggest-root"
     @onkeydown="OnKeyDownAsync"
     @onfocusin="OnFocusIn"
     @onfocusout="OnFocusLost">

    <FluentTextBox Header="@Header"
                   Placeholder="@Placeholder"
                   Disabled="@Disabled"
                   Value="@Text"
                   ValueChanged="OnTextChangedAsync"
                   @attributes="AdditionalAttributes"><Buttons>@if (EnableSearchIcon)
{
    @if (!string.IsNullOrEmpty(Text))
    {
        <FluentTextBoxButton Disabled="@Disabled" OnClick="ClearAsync">
            <FluentIcon Name="@FluentIconNames.Dismiss" Size="16" />
        </FluentTextBoxButton>
    }
    else
    {
        <FluentTextBoxButton Disabled="true">
            <FluentIcon Name="@FluentIconNames.Search" Size="16" />
        </FluentTextBoxButton>
    }
}</Buttons></FluentTextBox>

    @if (!Disabled && _open && Matches.Count > 0)
    {
        <ul class="fluent-autosuggest-dropdown" role="listbox" tabindex="-1">
            @for (var i = 0; i < Matches.Count; i++)
            {
                var item = Matches[i];
                var isHighlighted = i == _highlightedIndex;
                <li class="fluent-autosuggest-item @(isHighlighted ? "fluent-autosuggest-item--highlighted" : null) @(item.Disabled ? "fluent-autosuggest-item--disabled" : null)"
                    role="option"
                    aria-selected="@isHighlighted"
                    @onmousedown:preventDefault="true"
                    @onclick="() => ChooseAsync(item)">
                    @if (ItemTemplate is not null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        <span>@item.Name</span>
                    }
                </li>
            }
        </ul>
    }
</div>
