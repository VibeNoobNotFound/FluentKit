@namespace Fluent.Blazor.Composite
@implements IDisposable

@if (IsTargeted)
{
    <span @ref="_anchor" class="fluent-teachingtip-anchor">
        @ChildContent
    </span>
}

@code {
    // Declared here (not in the .cs code-behind) on purpose: CSS isolation only scopes markup that's
    // physically written in a .razor file. A RenderFragment built via RenderTreeBuilder in plain C#
    // never gets the scope attribute, so its styles in FluentTeachingTip.razor.css would silently
    // not apply.
    private RenderFragment RenderTipContent => @<div class="fluent-teachingtip @(IsTargeted ? $"fluent-teachingtip--{PlacementClass}" : "fluent-teachingtip--detached")">
        @if (IsTargeted)
        {
            <div class="fluent-teachingtip-beak" aria-hidden="true"></div>
        }
        <div class="fluent-teachingtip-body">
            <div class="fluent-teachingtip-text">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <div class="fluent-teachingtip-title">@Title</div>
                }
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <div class="fluent-teachingtip-subtitle">@Subtitle</div>
                }
            </div>
            <FluentIconButton OnClick="CloseAsync" AdditionalAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Close" })">
                <FluentIcon Name="@FluentIconNames.Dismiss" />
            </FluentIconButton>
        </div>
        @if (ActionContent is not null)
        {
            <div class="fluent-teachingtip-actions">@ActionContent</div>
        }
    </div>;
}
