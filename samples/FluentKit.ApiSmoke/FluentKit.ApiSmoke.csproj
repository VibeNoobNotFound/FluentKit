<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="FluentKit.Blazor" Version="$(FluentKitSmokeVersion)" />
  </ItemGroup>

  <Target Name="RequireFluentKitSmokeVersion" BeforeTargets="Restore">
    <Error Condition="'$(FluentKitSmokeVersion)' == ''"
           Text="FluentKit.ApiSmoke is an explicit package-consumer test. Pass -p:FluentKitSmokeVersion=&lt;version&gt;." />
  </Target>
</Project>
