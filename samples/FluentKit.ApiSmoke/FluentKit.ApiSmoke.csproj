<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This is a package-consumer smoke test, so keep it on the latest published release.
         The source package version is not available on NuGet until the release workflow runs. -->
    <FluentKitSmokeVersion>0.2.3</FluentKitSmokeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="FluentKit.Blazor" Version="$(FluentKitSmokeVersion)" />
  </ItemGroup>
</Project>
