@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IThemeService ThemeService
@inject IAccentColorService AccentColorService
@inject GalleryJsInterop GalleryJs

<ThemeProvider>
    @* Background material — switches between Mica (Base) and Mica Alt (Tabbed/BaseAlt) *@
    <FluentMicaPanel Variant="@_backgroundVariant" BackgroundImageUrl="@_wallpaperUrl"
                     style="position:fixed; inset:0; z-index:-1;" />

    <div style="width:100%; height:100dvh; position:relative; overflow:hidden;">
    <FluentNavigationView PaneDisplayMode="NavigationViewPaneDisplayMode.Auto"
                          @bind-IsPaneOpen="_paneOpen"
                          SelectedValue="@_selectedRoute"
                          ItemInvoked="OnItemInvoked"
                          IsBackButtonVisible="false"
                          ShowSettingsButton="false">

        <PaneHeaderIcon>
            <FluentIcon Name="ic_fluent_search_20_regular" Size="16" />
        </PaneHeaderIcon>

        <PaneHeader>
            <div class="nav-search-box" style="padding: 4px 2px 8px;">
                <FluentAutoSuggestBox TValue="string"
                                      Items="@GallerySearchIndex.SuggestionItems"
                                      @bind-Text="_searchText"
                                      Placeholder="Search"
                                      EnableSearchIcon="true"
                                      SuggestionChosen="OnSearchSuggestionChosen"
                                      QuerySubmitted="OnSearchQuerySubmitted" />
            </div>
        </PaneHeader>

        <MenuItems>
            @* ── Get Started ─────────────────────────────────────────── *@
            <FluentNavigationViewItem Value="@RouteHome" Text="Home">
                <Icon><FluentIcon Name="ic_fluent_home_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Design ─────────────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Design" />

            <FluentNavigationViewItem Value="@RouteIconBrowser" Text="Icons">
                <Icon><FluentIcon Name="ic_fluent_icons_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItem Value="@RouteSpacingGeometry" Text="Spacing &amp; geometry">
                <Icon><FluentIcon Name="ic_fluent_ruler_20_regular" /></Icon>
            </FluentNavigationViewItem>
            
            <FluentNavigationViewItem Value="@RouteColors" Text="Colors">
                <Icon><FluentIcon Name="ic_fluent_color_background_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItem Value="@RoutePlayground" Text="Playground">
                <Icon><FluentIcon Name="ic_fluent_code_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Basic Input ─────────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Basic Input" />

            <FluentNavigationViewItem Value="@(null)" Text="Buttons" IsSelectable="false">
                <Icon><FluentIcon Name="ic_fluent_cursor_click_20_regular" /></Icon>
                <ChildContent>
                    <FluentNavigationViewItem Value="@RouteButton" Text="Button">
                        <Icon><FluentIcon Name="ic_fluent_rectangle_landscape_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteToggleButton" Text="ToggleButton">
                        <Icon><FluentIcon Name="ic_fluent_toggle_multiple_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteIconButton" Text="IconButton">
                        <Icon><FluentIcon Name="ic_fluent_icons_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteDropDownButton" Text="DropDownButton">
                        <Icon><FluentIcon Name="ic_fluent_chevron_circle_down_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteSplitButton" Text="SplitButton">
                        <Icon><FluentIcon Name="ic_fluent_split_horizontal_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                </ChildContent>
            </FluentNavigationViewItem>

            <FluentNavigationViewItem Value="@(null)" Text="Selection" IsSelectable="false">
                <Icon><FluentIcon Name="ic_fluent_checkmark_circle_20_regular" /></Icon>
                <ChildContent>
                    <FluentNavigationViewItem Value="@RouteCheckBox" Text="CheckBox">
                        <Icon><FluentIcon Name="ic_fluent_checkbox_checked_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteRadioButton" Text="RadioButton">
                        <Icon><FluentIcon Name="ic_fluent_radio_button_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteToggleSwitch" Text="ToggleSwitch">
                        <Icon><FluentIcon Name="ic_fluent_toggle_left_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteSlider" Text="Slider">
                        <Icon><FluentIcon Name="ic_fluent_options_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                </ChildContent>
            </FluentNavigationViewItem>

            <FluentNavigationViewItem Value="@(null)" Text="Text" IsSelectable="false">
                <Icon><FluentIcon Name="ic_fluent_text_t_20_regular" /></Icon>
                <ChildContent>
                    <FluentNavigationViewItem Value="@RouteTextBlock" Text="TextBlock">
                        <Icon><FluentIcon Name="ic_fluent_text_description_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteTextBox" Text="TextBox">
                        <Icon><FluentIcon Name="ic_fluent_text_field_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RoutePasswordBox" Text="PasswordBox">
                        <Icon><FluentIcon Name="ic_fluent_password_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteNumberBox" Text="NumberBox">
                        <Icon><FluentIcon Name="ic_fluent_number_symbol_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                    <FluentNavigationViewItem Value="@RouteAutoSuggestBox" Text="AutoSuggestBox">
                        <Icon><FluentIcon Name="ic_fluent_search_20_regular" /></Icon>
                    </FluentNavigationViewItem>
                </ChildContent>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Status & Feedback ────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Status &amp; Feedback" />

            <FluentNavigationViewItem Value="@RouteProgressBar" Text="ProgressBar">
                <Icon><FluentIcon Name="ic_fluent_status_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteProgressRing" Text="ProgressRing">
                <Icon><FluentIcon Name="ic_fluent_spinner_ios_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteInfoBar" Text="InfoBar">
                <Icon><FluentIcon Name="ic_fluent_info_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteInfoBadge" Text="InfoBadge">
                <Icon><FluentIcon Name="ic_fluent_badge_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteTooltip" Text="Tooltip">
                <Icon><FluentIcon Name="ic_fluent_chat_bubbles_question_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteTeachingTip" Text="TeachingTip">
                <Icon><FluentIcon Name="ic_fluent_lightbulb_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Collections ─────────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Collections" />

            <FluentNavigationViewItem Value="@RouteListView" Text="ListView">
                <Icon><FluentIcon Name="ic_fluent_list_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteComboBox" Text="ComboBox">
                <Icon><FluentIcon Name="ic_fluent_chevron_down_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteCalendar" Text="Calendar &amp; DatePicker">
                <Icon><FluentIcon Name="ic_fluent_calendar_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteTimePicker" Text="TimePicker">
                <Icon><FluentIcon Name="ic_fluent_clock_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Navigation ───────────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Navigation" />

            <FluentNavigationViewItem Value="@RouteNavigationView" Text="NavigationView">
                <Icon><FluentIcon Name="ic_fluent_navigation_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RoutePivot" Text="Pivot">
                <Icon><FluentIcon Name="ic_fluent_tab_desktop_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteExpander" Text="Expander">
                <Icon><FluentIcon Name="ic_fluent_chevron_circle_down_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Flyouts & Menus ─────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Flyouts &amp; Menus" />

            <FluentNavigationViewItem Value="@RouteFlyout" Text="Flyout">
                <Icon><FluentIcon Name="ic_fluent_panel_right_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteMenuFlyout" Text="MenuFlyout">
                <Icon><FluentIcon Name="ic_fluent_list_bar_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteContextMenu" Text="ContextMenu">
                <Icon><FluentIcon Name="ic_fluent_apps_list_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteMenuBar" Text="MenuBar">
                <Icon><FluentIcon Name="ic_fluent_more_horizontal_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteContentDialog" Text="ContentDialog">
                <Icon><FluentIcon Name="ic_fluent_chat_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Layout ───────────────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Layout" />

            <FluentNavigationViewItem Value="@RouteCard" Text="Card">
                <Icon><FluentIcon Name="ic_fluent_card_ui_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RoutePersonPicture" Text="PersonPicture">
                <Icon><FluentIcon Name="ic_fluent_person_circle_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Settings ─────────────────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Settings" />

            <FluentNavigationViewItem Value="@RouteSettingsCard" Text="SettingsCard">
                <Icon><FluentIcon Name="ic_fluent_settings_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteSettingsExpander" Text="SettingsExpander">
                <Icon><FluentIcon Name="ic_fluent_chevron_circle_down_20_regular" /></Icon>
            </FluentNavigationViewItem>

            <FluentNavigationViewItemSeparator />

            @* ── Effects & Materials ─────────────────────────────────── *@
            <FluentNavigationViewItemHeader Text="Effects &amp; Materials" />

            <FluentNavigationViewItem Value="@RouteAcrylic" Text="Acrylic">
                <Icon><FluentIcon Name="ic_fluent_blur_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteMica" Text="Mica">
                <Icon><FluentIcon Name="ic_fluent_color_background_20_regular" /></Icon>
            </FluentNavigationViewItem>
            <FluentNavigationViewItem Value="@RouteReveal" Text="Reveal">
                <Icon><FluentIcon Name="ic_fluent_sparkle_20_regular" /></Icon>
            </FluentNavigationViewItem>

        </MenuItems>

        <PaneFooter>
            <FluentNavigationViewItem Value="@RouteSettings" Text="Settings">
                <Icon><FluentIcon Name="ic_fluent_settings_20_regular" /></Icon>
            </FluentNavigationViewItem>
        </PaneFooter>

        <ChildContent>
            @Body
        </ChildContent>
    </FluentNavigationView>
    </div>

    <FluentOverlayHost />
</ThemeProvider>

@code {
    // ── Route constants ────────────────────────────────────────────
    public const string RouteHome           = "";
    public const string RouteSpacingGeometry = "design/spacing-geometry";
    public const string RouteButton         = "controls/button";
    public const string RouteTextBlock      = "controls/textblock";
    public const string RouteCheckBox       = "controls/checkbox";
    public const string RouteRadioButton    = "controls/radiobutton";
    public const string RouteToggleSwitch   = "controls/toggleswitch";
    public const string RouteToggleButton   = "controls/togglebutton";
    public const string RouteTextBox        = "controls/textbox";
    public const string RoutePasswordBox    = "controls/passwordbox";
    public const string RouteSlider         = "controls/slider";
    public const string RouteProgressBar    = "controls/progressbar";
    public const string RouteProgressRing   = "controls/progressring";
    public const string RouteExpander       = "controls/expander";
    public const string RouteInfoBar        = "controls/infobar";
    public const string RouteInfoBadge      = "controls/infobadge";
    public const string RoutePersonPicture  = "controls/personpicture";
    public const string RouteIconButton     = "controls/iconbutton";
    public const string RouteCard           = "controls/card";
    public const string RouteSettingsCard     = "controls/settingscard";
    public const string RouteSettingsExpander = "controls/settingsexpander";
    public const string RouteListView       = "controls/listview";
    public const string RouteNavigationView = "controls/navigationview";
    public const string RouteComboBox       = "controls/combobox";
    public const string RouteAutoSuggestBox = "controls/autosuggestbox";
    public const string RouteNumberBox      = "controls/numberbox";
    public const string RouteCalendar       = "controls/calendar";
    public const string RouteFlyout         = "controls/flyout";
    public const string RouteMenuFlyout     = "controls/menuflyout";
    public const string RouteContextMenu    = "controls/contextmenu";
    public const string RouteMenuBar        = "controls/menubar";
    public const string RouteContentDialog  = "controls/contentdialog";
    public const string RouteTimePicker  = "controls/timepicker";
    public const string RoutePivot          = "controls/pivot";
    public const string RouteDropDownButton = "controls/dropdownbutton";
    public const string RouteSplitButton    = "controls/splitbutton";
    public const string RouteTooltip        = "controls/tooltip";
    public const string RouteTeachingTip    = "controls/teachingtip";
    public const string RouteAcrylic        = "controls/acrylic";
    public const string RouteMica           = "controls/mica";
    public const string RouteReveal         = "controls/reveal";
    public const string RouteIconBrowser    = "design/icons";
    public const string RouteColors         = "design/colors";
    public const string RoutePlayground     = "design/playground";
    public const string RouteSettings       = "settings";

    // ── Persisted-settings storage keys (browser localStorage) ──────
    // Only ever written from explicit user actions on the Settings page —
    // never from defaults — so a first-time visitor's storage stays empty.
    public const string ThemeModeStorageKey    = "fluentkit-gallery.theme-mode";
    public const string MicaVariantStorageKey  = "fluentkit-gallery.mica-variant";
    public const string WallpaperStorageKey    = "fluentkit-gallery.wallpaper-url";

    // ── Background material (toggled from Settings page) ───────────
    // Defaults to Tabbed (Mica Alt) — overridden at startup if the user has
    // a saved preference (see LoadPersistedSettingsAsync).
    internal static MicaVariant BackgroundVariantSetting = MicaVariant.BaseAlt;
    internal static event Action? BackgroundVariantChanged;
    internal static void SetBackgroundVariant(MicaVariant v)
    {
        BackgroundVariantSetting = v;
        BackgroundVariantChanged?.Invoke();
    }

    internal static string WallpaperUrlSetting = "_content/FluentKit.Sample.Shared/wallpaper.jpg";
    internal static event Action? WallpaperUrlChanged;
    internal static void SetWallpaperUrl(string url)
    {
        WallpaperUrlSetting = url;
        WallpaperUrlChanged?.Invoke();
    }

    // ── State ──────────────────────────────────────────────────────
    private bool _paneOpen = true;
    private object? _selectedRoute;
    private MicaVariant _backgroundVariant = BackgroundVariantSetting;
    private string _wallpaperUrl = WallpaperUrlSetting;
    private string? _searchText;

    protected override void OnInitialized()
    {
        SyncSelectionFromUrl(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
        BackgroundVariantChanged += OnBackgroundVariantChanged;
        WallpaperUrlChanged += OnWallpaperUrlChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPersistedSettingsAsync();

            // "Automatically pick an accent color from my background" — derive the accent ramp
            // from whatever wallpaper ended up active (default or a restored custom one) so the
            // very first paint already reflects it, not just subsequent wallpaper changes.
            await AccentColorService.SetAccentFromImageAsync(_wallpaperUrl);
        }
    }

    // Restores theme mode, Mica variant, and wallpaper from localStorage, if the
    // user previously changed any of them. Silently keeps built-in defaults for
    // anything that was never saved (or if storage is unavailable/corrupt).
    private async Task LoadPersistedSettingsAsync()
    {
        try
        {
            var savedMode = await GalleryJs.GetStorageItemAsync(ThemeModeStorageKey);
            if (!string.IsNullOrEmpty(savedMode) && Enum.TryParse<ThemeMode>(savedMode, out var mode))
            {
                await ThemeService.SetModeAsync(mode);
            }

            var savedVariant = await GalleryJs.GetStorageItemAsync(MicaVariantStorageKey);
            if (!string.IsNullOrEmpty(savedVariant) && Enum.TryParse<MicaVariant>(savedVariant, out var variant))
            {
                SetBackgroundVariant(variant);
            }

            var savedWallpaper = await GalleryJs.GetStorageItemAsync(WallpaperStorageKey);
            if (!string.IsNullOrEmpty(savedWallpaper))
            {
                SetWallpaperUrl(savedWallpaper);
            }
        }
        catch
        {
            // localStorage unavailable (e.g. private browsing) or a corrupt value — fall back to defaults.
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncSelectionFromUrl(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void OnBackgroundVariantChanged()
    {
        _backgroundVariant = BackgroundVariantSetting;
        InvokeAsync(StateHasChanged);
    }

    private void OnWallpaperUrlChanged()
    {
        _wallpaperUrl = WallpaperUrlSetting;
        InvokeAsync(StateHasChanged);
        // Re-derive the accent ramp every time the wallpaper changes — this is the live
        // "wallpaper -> accent color" pipeline the Colors design page demonstrates.
        InvokeAsync(() => AccentColorService.SetAccentFromImageAsync(_wallpaperUrl));
    }

    private void SyncSelectionFromUrl(string uri)
    {
        // ToBaseRelativePath strips the app's <base href> (e.g. "/FluentKit/")
        // automatically, so this matches the RouteXxx constants regardless of
        // whether the app is hosted at the domain root or a GitHub Pages subpath.
        var path = Navigation.ToBaseRelativePath(uri).TrimEnd('/');
        _selectedRoute = path;
    }

    private void OnItemInvoked(object? value)
    {
        // `value is string` alone is the correct check here: RouteHome is
        // legitimately "" (empty), and NavigateTo("") is valid — it goes to
        // the base URI. Non-selectable group headers pass Value="@(null)",
        // which correctly fails the `is string` pattern match and is ignored.
        if (value is string route)
        {
            Navigation.NavigateTo(route);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        BackgroundVariantChanged -= OnBackgroundVariantChanged;
        WallpaperUrlChanged -= OnWallpaperUrlChanged;
    }

    // Picking a suggestion (click, or Enter while one is highlighted) jumps straight to that page.
    private void OnSearchSuggestionChosen(AutoSuggestBoxItem<string> item)
    {
        _searchText = "";
        Navigation.NavigateTo(item.Value);
    }

    // Enter with no suggestion highlighted opens a dedicated results page for the raw query text,
    // same as WinUI Gallery's "show all results" behavior.
    private void OnSearchQuerySubmitted(string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        _searchText = "";
        Navigation.NavigateTo($"search?q={Uri.EscapeDataString(query)}");
    }
}
