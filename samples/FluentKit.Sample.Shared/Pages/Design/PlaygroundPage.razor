@page "/design/playground"
@using FluentKit.Composite
@using FluentKit.Primitives
@using FluentKit.Sample.Shared.Services
@using FluentKit.Sample.Shared.Shared
@inject IRazorPlaygroundCompiler Compiler
@inject GalleryJsInterop GalleryJs

<div class="gallery-page">
    <PageHeader Eyebrow="Design" Title="Playground" Description="@PageDescription" />

    <div class="playground">
        <div class="playground__preview">
            @if (_compiledType is not null)
            {
                <DynamicComponent Type="_compiledType" />
            }
            else
            {
                <div class="playground__preview-empty">
                    Click <strong>Run</strong> to render the component below.
                </div>
            }
        </div>

        <div class="playground__editor-bar">
            <FluentButton Variant="ButtonVariant.Accent" OnClick="RunAsync" Disabled="_isCompiling">
                @(_isCompiling ? "Running…" : "Run")
            </FluentButton>
            <FluentButton Variant="ButtonVariant.Standard" OnClick="ResetToDefault">
                Reset
            </FluentButton>
            @if (_status is not null)
            {
                <span class="playground__status @(_lastRunFailed ? "playground__status--error" : "playground__status--ok")">
                    @_status
                </span>
            }
        </div>

        <div class="playground__code-panel">
            <div class="playground__editor">
                <pre class="playground__highlight" aria-hidden="true"><code id="@_codeElementId" class="language-markup"></code></pre>
                <textarea id="@_textareaId"
                          class="playground__textarea"
                          spellcheck="false"
                          value="@_source"
                          @oninput="OnSourceInput"
                          aria-label="Razor component source"></textarea>
            </div>
        </div>

        @if (_diagnostics.Count > 0)
        {
            <div class="playground__diagnostics">
                @foreach (var diagnostic in _diagnostics)
                {
                    <div class="playground__diagnostic">@diagnostic</div>
                }
            </div>
        }
    </div>
</div>

@code {
    // NOTE: this used to be inlined directly as the PageHeader's Description="..." attribute
    // value, containing a literal "@@code" (Razor's escape for a literal @). Component
    // attributes only support a single expression or a plain literal — they don't support
    // "complex content" (a mix of literal text and an @-escape/expression), which is exactly
    // what that string was. Razor's compiler flags that as RZ9986 and fails the build. A plain
    // C# field has no such restriction (a single "@" isn't special in a C# string), so the text
    // moves here and the attribute becomes a simple single-expression binding instead.
    private const string PageDescription =
        "Write a Razor component — markup and an optional @code block — and see it rendered " +
        "live. Everything runs in your browser: the same Razor engine and Roslyn compiler the " +
        "SDK uses at build time, just running client-side instead. Nothing is sent to a server.";

    private string _source = DefaultSource;
    private Type? _compiledType;
    private bool _isCompiling;
    private bool _lastRunFailed;
    private string? _status;
    private List<string> _diagnostics = [];

    private readonly string _textareaId = $"playground-src-{Guid.NewGuid():N}";
    private readonly string _codeElementId = $"playground-code-{Guid.NewGuid():N}";

    protected override async Task OnInitializedAsync()
    {
        // Warm the compiler (fetches metadata references) in the background so the first
        // real "Run" click doesn't eat the fetch cost.
        _ = Compiler.WarmUpAsync();
        await RunAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Paint the initial default source into the highlighted overlay and wire up
            // scroll sync — same "highlight the <code>, sync scroll of the <pre> to the
            // <textarea> on top of it" pattern used by SampleCodeBlock, just live instead
            // of static.
            await GalleryJs.LiveHighlightAsync(_codeElementId, _source);
            await GalleryJs.LiveHighlightSyncScrollAsync(_textareaId, _codeElementId);
        }
    }

    private async Task OnSourceInput(ChangeEventArgs args)
    {
        _source = args.Value?.ToString() ?? "";
        // Re-highlight on every keystroke. This only touches the <code> element directly
        // via JS (textContent + Prism.highlightElement) — it doesn't go through Blazor's
        // render pipeline, so it stays responsive even for larger snippets.
        await GalleryJs.LiveHighlightAsync(_codeElementId, _source);
    }

    private async Task RunAsync()
    {
        _isCompiling = true;
        _diagnostics = [];
        StateHasChanged();

        var result = await Compiler.CompileAsync(_source);

        if (result.Success)
        {
            _compiledType = result.ComponentType;
            _lastRunFailed = false;
            _status = "Run successful.";
        }
        else
        {
            _lastRunFailed = true;
            _status = "Run failed — see errors below.";
            _diagnostics = [.. result.RazorDiagnostics, .. result.CSharpDiagnostics];
            if (result.PipelineError is not null)
            {
                _diagnostics.Add(result.PipelineError);
            }
        }

        _isCompiling = false;
        StateHasChanged();
    }

    private async Task ResetToDefault()
    {
        _source = DefaultSource;
        await GalleryJs.LiveHighlightAsync(_codeElementId, _source);
        await RunAsync();
    }

    private const string DefaultSource =
"""
<div style="padding:12px; border:1px solid var(--card-stroke-default); border-radius:8px;">
    <p>This is a live FluentKit Playground component.</p>
    <FluentButton Variant="ButtonVariant.Accent" OnClick="Increment">Clicked @count times</FluentButton>
</div>

@code {
    private int count = 0;
    private void Increment() => count++;
}
""";
}
