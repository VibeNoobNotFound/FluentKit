@page "/controls/radiobutton"

<div class="gallery-page">
    <PageHeader Eyebrow="Primitives" Title="RadioButton" Description="RadioButton allows a user to select one option from a mutually exclusive group." />

    <ControlExample HeaderText="RadioButton Group" RazorCode="@_radioRazor" CSharpCode="@_radioCs">
        <Example>
            <div class="demo-col">
                <FluentRadioGroup @bind-Value="_selectedFlavor">
                    <div class="demo-col">
                        <FluentRadioButton Value='@("Chocolate")'>Chocolate</FluentRadioButton>
                        <FluentRadioButton Value='@("Vanilla")'>Vanilla</FluentRadioButton>
                        <FluentRadioButton Value='@("Strawberry")'>Strawberry</FluentRadioButton>
                        <FluentRadioButton Value='@("Mint")' Disabled="true">Mint (disabled)</FluentRadioButton>
                    </div>
                </FluentRadioGroup>
                <div class="demo-output">Selected: @_selectedFlavor</div>
            </div>
        </Example>
    </ControlExample>

    <ControlExample HeaderText="Custom ItemTemplate" RazorCode="@_templateRazor" CSharpCode="@_templateCs">
        <Example>
            <div class="demo-col">
                <FluentRadioGroup @bind-Value="_selectedView">
                    <div class="demo-row" style="gap:8px;">
                        <FluentRadioButton Value='@("list")'>
                            <ItemTemplate Context="selected">
                                <span style="display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:6px; background:@(selected ? "var(--accent-fill-color-default)" : "transparent"); color:@(selected ? "var(--accent-text-fill-color-primary)" : "inherit");">
                                    <FluentIcon Name="ic_fluent_list_20_regular" Size="16" /> List
                                </span>
                            </ItemTemplate>
                        </FluentRadioButton>
                        <FluentRadioButton Value='@("grid")'>
                            <ItemTemplate Context="selected">
                                <span style="display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:6px; background:@(selected ? "var(--accent-fill-color-default)" : "transparent"); color:@(selected ? "var(--accent-text-fill-color-primary)" : "inherit");">
                                    <FluentIcon Name="ic_fluent_grid_20_regular" Size="16" /> Grid
                                </span>
                            </ItemTemplate>
                        </FluentRadioButton>
                    </div>
                </FluentRadioGroup>
                <div class="demo-output">View: @_selectedView</div>
            </div>
        </Example>
    </ControlExample>
</div>

@code {
    private object? _selectedFlavor = "Chocolate";

    private const string _radioRazor = @"<FluentRadioGroup @bind-Value=""_selectedFlavor"">
    <div class=""demo-col"">
        <FluentRadioButton Value='@(""Chocolate"")'>Chocolate</FluentRadioButton>
        <FluentRadioButton Value='@(""Vanilla"")'>Vanilla</FluentRadioButton>
        <FluentRadioButton Value='@(""Strawberry"")'>Strawberry</FluentRadioButton>
        <FluentRadioButton Value='@(""Mint"")' Disabled=""true"">Mint (disabled)</FluentRadioButton>
    </div>
</FluentRadioGroup>";

    private const string _radioCs = @"private object? _selectedFlavor = ""Chocolate"";";

    private object? _selectedView = "list";

    private const string _templateRazor = @"<FluentRadioGroup @bind-Value=""_selectedView"">
    <FluentRadioButton Value='@(""list"")'>
        <ItemTemplate Context=""selected"">
            <span class=""view-choice @(selected ? ""view-choice--selected"" : null)"">
                <FluentIcon Name=""ic_fluent_list_20_regular"" Size=""16"" /> List
            </span>
        </ItemTemplate>
    </FluentRadioButton>
    <FluentRadioButton Value='@(""grid"")'>
        <ItemTemplate Context=""selected"">
            <span class=""view-choice @(selected ? ""view-choice--selected"" : null)"">
                <FluentIcon Name=""ic_fluent_grid_20_regular"" Size=""16"" /> Grid
            </span>
        </ItemTemplate>
    </FluentRadioButton>
</FluentRadioGroup>";
    private const string _templateCs = @"private object? _selectedView = ""list"";";
}
