@page "/controls/menubar"
@using FluentKit.Composite

<div class="gallery-page">
    <PageHeader Eyebrow="Composite Controls" Title="MenuBar" Description="Use MenuBar to display a horizontal top-level navigation bar for applications." />

    <ControlExample HeaderText="Standard MenuBar Layout" RazorCode="@_barRazor" CSharpCode="@_barCs">
        <Example>
            <div class="demo-col">
                <FluentMenuBar>
                    <FluentMenuBarItem>
                        <ChildContent>File</ChildContent>
                        <Flyout>
                            <FluentMenuFlyoutItem OnClick='@(() => LogAction("New"))'>New</FluentMenuFlyoutItem>
                            <FluentMenuFlyoutItem OnClick='@(() => LogAction("Open"))'>Open...</FluentMenuFlyoutItem>
                            <FluentMenuFlyoutDivider />
                            <FluentMenuFlyoutItem OnClick='@(() => LogAction("Exit"))'>Exit</FluentMenuFlyoutItem>
                        </Flyout>
                    </FluentMenuBarItem>
                    <FluentMenuBarItem>
                        <ChildContent>Edit</ChildContent>
                        <Flyout>
                            <FluentMenuFlyoutItem OnClick='@(() => LogAction("Cut"))'>Cut</FluentMenuFlyoutItem>
                            <FluentMenuFlyoutItem OnClick='@(() => LogAction("Copy"))'>Copy</FluentMenuFlyoutItem>
                            <FluentMenuFlyoutItem OnClick='@(() => LogAction("Paste"))'>Paste</FluentMenuFlyoutItem>
                        </Flyout>
                    </FluentMenuBarItem>
                    <FluentMenuBarItem>
                        <ChildContent>View</ChildContent>
                        <Flyout>
                            <FluentMenuFlyoutItem Variant="MenuFlyoutItemVariant.Toggle" @bind-Checked="_showGrid">Show grid</FluentMenuFlyoutItem>
                            <FluentMenuFlyoutItem Cascading="true">
                                <ChildContent>Zoom</ChildContent>
                                <Flyout>
                                    <FluentMenuFlyoutItem OnClick='@(() => LogAction("Zoom In"))'>Zoom In</FluentMenuFlyoutItem>
                                    <FluentMenuFlyoutItem OnClick='@(() => LogAction("Zoom Out"))'>Zoom Out</FluentMenuFlyoutItem>
                                </Flyout>
                            </FluentMenuFlyoutItem>
                        </Flyout>
                    </FluentMenuBarItem>
                    <FluentMenuBarItem Disabled="true">
                        <ChildContent>Disabled</ChildContent>
                    </FluentMenuBarItem>
                </FluentMenuBar>
                <div class="demo-output" style="margin-top: 12px; font-size: 12px; opacity: 0.8;">Last Menu Action: @_menuAction | Show Grid: @_showGrid</div>
            </div>
        </Example>
    </ControlExample>
</div>

@code {
    private string? _menuAction;
    private bool _showGrid;

    private void LogAction(string act) => _menuAction = act;

    private const string _barRazor = @"<FluentMenuBar>
    <FluentMenuBarItem>
        <ChildContent>File</ChildContent>
        <Flyout>
            <FluentMenuFlyoutItem OnClick='@(() => LogAction(""New""))'>New</FluentMenuFlyoutItem>
            <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Open""))'>Open...</FluentMenuFlyoutItem>
            <FluentMenuFlyoutDivider />
            <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Exit""))'>Exit</FluentMenuFlyoutItem>
        </Flyout>
    </FluentMenuBarItem>
    <FluentMenuBarItem>
        <ChildContent>Edit</ChildContent>
        <Flyout>
            <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Cut""))'>Cut</FluentMenuFlyoutItem>
            <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Copy""))'>Copy</FluentMenuFlyoutItem>
            <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Paste""))'>Paste</FluentMenuFlyoutItem>
        </Flyout>
    </FluentMenuBarItem>
    <FluentMenuBarItem>
        <ChildContent>View</ChildContent>
        <Flyout>
            <FluentMenuFlyoutItem Variant=""MenuFlyoutItemVariant.Toggle"" @bind-Checked=""_showGrid"">Show grid</FluentMenuFlyoutItem>
            <FluentMenuFlyoutItem Cascading=""true"">
                <ChildContent>Zoom</ChildContent>
                <Flyout>
                    <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Zoom In""))'>Zoom In</FluentMenuFlyoutItem>
                    <FluentMenuFlyoutItem OnClick='@(() => LogAction(""Zoom Out""))'>Zoom Out</FluentMenuFlyoutItem>
                </Flyout>
            </FluentMenuFlyoutItem>
        </Flyout>
    </FluentMenuBarItem>
    <FluentMenuBarItem Disabled=""true"">
        <ChildContent>Disabled</ChildContent>
    </FluentMenuBarItem>
</FluentMenuBar>";

    private const string _barCs = @"private string? _menuAction;
private bool _showGrid;
private void LogAction(string act) => _menuAction = act;";
}
