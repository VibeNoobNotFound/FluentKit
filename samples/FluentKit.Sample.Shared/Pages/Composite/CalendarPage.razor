@page "/controls/calendar"
@using FluentKit.Composite

<div class="gallery-page">
    <PageHeader Eyebrow="Composite Controls" Title="Calendar &amp; DatePicker" Description="CalendarView lets users browse and select dates. CalendarDatePicker displays this calendar in a popup." />

    <ControlExample HeaderText="Standalone CalendarView with Blackout Dates" RazorCode="@_calRazor" CSharpCode="@_calCs">
        <Example>
            <div class="demo-col" style="align-items: flex-start; gap: 8px;">
                <FluentCalendarView @bind-Value="_selectedDate" Blackout="@_calendarBlackout" Headers="true" />
                <div class="demo-output" style="font-size: 12px; opacity: 0.8;">Selected Date: @_selectedDate?.ToShortDateString() (Blackout dates: tomorrow + 3 &amp; tomorrow + 4)</div>
            </div>
        </Example>
    </ControlExample>

    <ControlExample HeaderText="CalendarView Selection Modes" RazorCode="@_modesRazor" CSharpCode="@_modesCs">
        <Example>
            <div style="display:flex; gap:48px; align-items:flex-start; flex-wrap:wrap;">
                <div class="demo-col" style="align-items: flex-start; gap: 8px;">
                    <span style="font-size: 11px; opacity: 0.7;">Single</span>
                    <FluentCalendarView @bind-Value="_singleDate" />
                    <div class="demo-output" style="font-size: 12px; opacity: 0.8;">@_singleDate?.ToShortDateString()</div>
                </div>
                <div class="demo-col" style="align-items: flex-start; gap: 8px;">
                    <span style="font-size: 11px; opacity: 0.7;">Multiple</span>
                    <FluentCalendarView SelectionMode="CalendarSelectionMode.Multiple" @bind-Values="_multiDates" />
                    <div class="demo-output" style="font-size: 12px; opacity: 0.8;">@_multiDates.Count date(s) selected</div>
                </div>
                <div class="demo-col" style="align-items: flex-start; gap: 8px;">
                    <span style="font-size: 11px; opacity: 0.7;">Range</span>
                    <FluentCalendarView SelectionMode="CalendarSelectionMode.Range" @bind-Values="_rangeDates" />
                    <div class="demo-output" style="font-size: 12px; opacity: 0.8;">
                        @(_rangeDates.Count == 2 ? $"{_rangeDates[0]:d} \u2013 {_rangeDates[1]:d}" : _rangeDates.Count == 1 ? $"{_rangeDates[0]:d} \u2013 …" : "No range selected")
                    </div>
                </div>
            </div>
        </Example>
    </ControlExample>

    <ControlExample HeaderText="CalendarDatePicker Variants" RazorCode="@_pickerRazor" CSharpCode="@_pickerCs">
        <Example>
            <div style="display:flex; gap:48px; align-items:flex-start; flex-wrap:wrap;">
                <div class="demo-col" style="max-width: 240px; gap: 4px;">
                    <span style="font-size: 11px; opacity: 0.7;">Standard</span>
                    <FluentCalendarDatePicker @bind-Value="_pickedDate" />
                    <div class="demo-output" style="font-size: 11px; opacity: 0.8;">Picked: @_pickedDate?.ToShortDateString()</div>
                </div>
                <div class="demo-col" style="max-width: 240px; gap: 4px;">
                    <span style="font-size: 11px; opacity: 0.7;">With Min/Max (This Month Only)</span>
                    <FluentCalendarDatePicker @bind-Value="_pickedRangedDate" Min="@_datePickerMin" Max="@_datePickerMax" />
                    <div class="demo-output" style="font-size: 11px; opacity: 0.8;">Picked: @_pickedRangedDate?.ToShortDateString()</div>
                </div>
                <div class="demo-col" style="max-width: 240px; gap: 4px;">
                    <span style="font-size: 11px; opacity: 0.7;">Disabled</span>
                    <FluentCalendarDatePicker Value="@DateTime.Today" Disabled="true" />
                </div>
                <div class="demo-col" style="max-width: 240px; gap: 4px;">
                    <span style="font-size: 11px; opacity: 0.7;">Multiple</span>
                    <FluentCalendarDatePicker SelectionMode="CalendarSelectionMode.Multiple" @bind-Values="_pickedMultiDates" />
                </div>
                <div class="demo-col" style="max-width: 240px; gap: 4px;">
                    <span style="font-size: 11px; opacity: 0.7;">Range</span>
                    <FluentCalendarDatePicker SelectionMode="CalendarSelectionMode.Range" @bind-Values="_pickedRangeDates" />
                </div>
            </div>
        </Example>
    </ControlExample>
</div>

@code {
    private DateTime? _selectedDate = DateTime.Today;
    private readonly IReadOnlyList<DateTime> _calendarBlackout = new List<DateTime> 
    { 
        DateTime.Today.AddDays(3), 
        DateTime.Today.AddDays(4) 
    };

    private DateTime? _pickedDate;
    private DateTime? _pickedRangedDate;
    private readonly DateTime _datePickerMin = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private readonly DateTime _datePickerMax = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);

    private DateTime? _singleDate = DateTime.Today;
    private IReadOnlyList<DateTime> _multiDates = Array.Empty<DateTime>();
    private IReadOnlyList<DateTime> _rangeDates = Array.Empty<DateTime>();

    private IReadOnlyList<DateTime> _pickedMultiDates = Array.Empty<DateTime>();
    private IReadOnlyList<DateTime> _pickedRangeDates = Array.Empty<DateTime>();

    private const string _modesRazor = @"<!-- Single (default) -->
<FluentCalendarView @bind-Value=""_singleDate"" />

<!-- Multiple -->
<FluentCalendarView SelectionMode=""CalendarSelectionMode.Multiple"" @bind-Values=""_multiDates"" />

<!-- Range: first click sets the start, second click completes it -->
<FluentCalendarView SelectionMode=""CalendarSelectionMode.Range"" @bind-Values=""_rangeDates"" />";

    private const string _modesCs = @"private DateTime? _singleDate = DateTime.Today;
private IReadOnlyList<DateTime> _multiDates = Array.Empty<DateTime>();
private IReadOnlyList<DateTime> _rangeDates = Array.Empty<DateTime>();";

    private const string _calRazor = @"<FluentCalendarView @bind-Value=""_selectedDate"" Blackout=""@_calendarBlackout"" Headers=""true"" />";
    private const string _calCs = @"private DateTime? _selectedDate = DateTime.Today;
private readonly IReadOnlyList<DateTime> _calendarBlackout = new List<DateTime> 
{ 
    DateTime.Today.AddDays(3), 
    DateTime.Today.AddDays(4) 
};";

    private const string _pickerRazor = @"<!-- Standard -->
<FluentCalendarDatePicker @bind-Value=""_pickedDate"" />

<!-- Min / Max (current month only) -->
<FluentCalendarDatePicker @bind-Value=""_pickedRangedDate"" Min=""@_datePickerMin"" Max=""@_datePickerMax"" />

<!-- Disabled -->
<FluentCalendarDatePicker Value=""@DateTime.Today"" Disabled=""true"" />

<!-- Multiple: popout stays open so the user can keep toggling dates -->
<FluentCalendarDatePicker SelectionMode=""CalendarSelectionMode.Multiple"" @bind-Values=""_pickedMultiDates"" />

<!-- Range: popout closes automatically once both start and end are picked -->
<FluentCalendarDatePicker SelectionMode=""CalendarSelectionMode.Range"" @bind-Values=""_pickedRangeDates"" />";

    private const string _pickerCs = @"private DateTime? _pickedDate;
private DateTime? _pickedRangedDate;
private readonly DateTime _datePickerMin = new(DateTime.Today.Year, DateTime.Today.Month, 1);
private readonly DateTime _datePickerMax = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
private IReadOnlyList<DateTime> _pickedMultiDates = Array.Empty<DateTime>();
private IReadOnlyList<DateTime> _pickedRangeDates = Array.Empty<DateTime>();";
}
