@page "/controls/passwordbox"

<div class="gallery-page">
    <PageHeader Eyebrow="Primitives" Title="PasswordBox" Description="Use PasswordBox to securely capture confidential single-line passwords." />

    <ControlExample HeaderText="PasswordBox with Eye Toggle" RazorCode="@_passRazor" CSharpCode="@_passCs">
        <Example>
            <div class="demo-col" style="max-width: 280px;">
                <FluentPasswordBox Header="Enter Password" Placeholder="Password" @bind-Value="_password" />
            </div>
        </Example>
    </ControlExample>
</div>

@code {
    private string? _password;

    private const string _passRazor = @"<FluentPasswordBox Header=""Enter Password"" Placeholder=""Password"" @bind-Value=""_password"" />";
    private const string _passCs = @"private string? _password;";
}
