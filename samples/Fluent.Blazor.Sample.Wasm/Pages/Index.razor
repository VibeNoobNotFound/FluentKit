@page "/"
@inject IThemeService ThemeService

<FluentMicaPanel Variant="_mainMicaVariant" BackgroundImageUrl="wallpaper.jpg"
                  style="@_mainMicaPanelStyle" />

<div style="padding: 40px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start; position:relative; min-height:100vh;">

    <div style="display:flex; gap:8px;">
        <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Light))">Light</FluentButton>
        <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Dark))">Dark</FluentButton>
        <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.System))">System</FluentButton>
    </div>

    <div style="display:flex; gap:8px; align-items:center;">
        <FluentButton Variant="ButtonVariant.Standard">Standard</FluentButton>
        <FluentButton Variant="ButtonVariant.Accent">Accent</FluentButton>
        <FluentButton Variant="ButtonVariant.Subtle">Subtle</FluentButton>
        <FluentButton Variant="ButtonVariant.Hyperlink">Hyperlink</FluentButton>
        <FluentButton Variant="ButtonVariant.Standard" Disabled="true">Disabled</FluentButton>
    </div>

    <div>
        <FluentTooltip Text="This popup is rendered by FluentOverlayHost, not by the button itself.">
            <FluentButton Variant="ButtonVariant.Standard">Hover me — proves the overlay infra</FluentButton>
        </FluentTooltip>
    </div>

    <FluentDivider />

    <FluentTextBlock Variant="TextBlockVariant.Title">Fluent.Blazor primitives</FluentTextBlock>

    <div style="display:flex; flex-direction:column; gap:6px;">
        <FluentTextBlock Variant="TextBlockVariant.Display">Display</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.TitleLarge">Title large</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.Title">Title</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.Subtitle">Subtitle</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.BodyLarge">Body large</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.BodyStrong">Body strong</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.Body">Body</FluentTextBlock>
        <FluentTextBlock Variant="TextBlockVariant.Caption">Caption</FluentTextBlock>
    </div>

    <FluentDivider />

    <div style="display:flex; flex-direction:column; gap:12px;">
        <FluentCheckBox @bind-Checked="_checkbox1">Wi-Fi</FluentCheckBox>
        <FluentCheckBox @bind-Checked="_checkbox2" ThreeState="true" @bind-Indeterminate="_checkboxIndeterminate">Select all (three-state)</FluentCheckBox>
        <FluentCheckBox Checked="true" Disabled="true">Disabled, checked</FluentCheckBox>
    </div>

    <FluentDivider />

    <FluentRadioGroup @bind-Value="_flavor">
        <div style="display:flex; flex-direction:column; gap:12px;">
            <FluentRadioButton Value="@("chocolate")">Chocolate</FluentRadioButton>
            <FluentRadioButton Value="@("vanilla")">Vanilla</FluentRadioButton>
            <FluentRadioButton Value="@("strawberry")">Strawberry</FluentRadioButton>
            <FluentRadioButton Value="@("mint")" Disabled="true">Mint (disabled)</FluentRadioButton>
        </div>
    </FluentRadioGroup>
    <FluentTextBlock Variant="TextBlockVariant.Caption">Selected: @_flavor</FluentTextBlock>

    <FluentDivider />

    <FluentToggleSwitch @bind-Checked="_wifiEnabled" Header="Wi-Fi" />
    <FluentToggleSwitch Checked="true" Disabled="true" Header="Airplane mode (disabled)" />

    <FluentDivider />

    <FluentTextBox @bind-Value="_name" Header="Name" Placeholder="Enter your name" />
    <FluentTextBlock Variant="TextBlockVariant.Caption">You typed: @_name</FluentTextBlock>
    <FluentTextBox Value="Can't touch this" Header="Disabled" Disabled="true" />

    <FluentDivider />

    <FluentTextBlock Variant="TextBlockVariant.Title">Materials: Mica vs. Acrylic</FluentTextBlock>
    <FluentTextBlock Variant="TextBlockVariant.Caption" style="max-width:640px;">
        The page background behind all of this is FluentMicaPanel, pinned with <code>position:fixed</code>
        so it behaves like a real window backdrop — it doesn't scroll with the page, it just stretches
        or compacts to match the current viewport/window size. The two demos below show each material
        in the kind of small, self-contained context you'd actually use them in.
    </FluentTextBlock>

    <FluentTextBlock Variant="TextBlockVariant.BodyStrong">Acrylic — Base vs. Thin</FluentTextBlock>
    <FluentTextBlock Variant="TextBlockVariant.Caption" style="max-width:640px;">
        Acrylic doesn't need a background image of its own — it live-blurs whatever's actually behind
        it. Small floating cards here, sat over a photo, so you see the live backdrop-filter blur
        plus each kind's own tint strength: Base reads near-opaque, Thin noticeably more see-through
        — the same contrast as a flyout/context-menu (Thin) vs. a nav pane (Base) in a real WinUI app.
    </FluentTextBlock>
    <div style="position:relative; width:320px; height:200px; border-radius:8px; overflow:hidden;">
        <div style="position:absolute; inset:0; background-image:url('wallpaper.jpg'); background-size:cover; background-position:center;"></div>
        <FluentAcrylicBrush Kind="AcrylicKind.Base" style="position:absolute; top:14px; left:14px; width:130px; padding:10px 12px; border-radius:6px;">
            <FluentTextBlock Variant="TextBlockVariant.BodyStrong">Base</FluentTextBlock>
            <FluentTextBlock Variant="TextBlockVariant.Caption">Near-opaque</FluentTextBlock>
        </FluentAcrylicBrush>
        <FluentAcrylicBrush Kind="AcrylicKind.Thin" style="position:absolute; bottom:14px; right:14px; width:130px; padding:10px 12px; border-radius:6px;">
            <FluentTextBlock Variant="TextBlockVariant.BodyStrong">Thin</FluentTextBlock>
            <FluentTextBlock Variant="TextBlockVariant.Caption">More see-through</FluentTextBlock>
        </FluentAcrylicBrush>
    </div>

    <FluentTextBlock Variant="TextBlockVariant.BodyStrong">Mica — Base vs. Base Alt (Tabbed)</FluentTextBlock>
    <FluentTextBlock Variant="TextBlockVariant.Caption" style="max-width:640px;">
        Mica is a window-level material, so this switches the actual main app background above,
        not a boxed-off sample. Base is the standard window surface tint; Base Alt is the stronger
        tint WinUI uses for commanding/tabbed surfaces.
    </FluentTextBlock>
    <FluentRadioGroup @bind-Value="_mainMicaVariantString">
        <div style="display:flex; gap:16px;">
            <FluentRadioButton Value="@("base")">Base</FluentRadioButton>
            <FluentRadioButton Value="@("basealt")">Base Alt (Tabbed)</FluentRadioButton>
            <FluentRadioButton Value="@("none")">None</FluentRadioButton>
        </div>
    </FluentRadioGroup>

    <FluentTextBlock Variant="TextBlockVariant.Caption" style="max-width:640px;">
        wallpaper.heic only decodes in Safari (native OS decoder) — other browsers silently fail to
        load it and the main Mica background above gracefully falls back to WinUI's own documented
        solid fill instead, same as real Mica falling back under RDP or Battery Saver. For
        cross-browser testing, convert it once (macOS):
        <code>sips -s format jpeg wallpaper.heic --out wallpaper.jpg</code>
        and swap the BackgroundImageUrl reference above to "wallpaper.jpg".
    </FluentTextBlock>

</div>

@code {
    private bool _checkbox1;
    private bool _checkbox2;
    private bool _checkboxIndeterminate = true;
    private object? _flavor = "vanilla";
    private bool _wifiEnabled = true;
    private string? _name;

    private MicaVariant _mainMicaVariant = MicaVariant.Base;
    private string _mainMicaMode = "base";
    private string _mainMicaPanelStyle => $"position:fixed; inset:0; z-index:-1; display:{(_mainMicaMode == "none" ? "none" : "block")};";
    private object? _mainMicaVariantString
    {
        get => _mainMicaMode;
        set
        {
            _mainMicaMode = (value as string) ?? "base";
            _mainMicaVariant = _mainMicaMode == "basealt" ? MicaVariant.BaseAlt : MicaVariant.Base;
        }
    }
}
