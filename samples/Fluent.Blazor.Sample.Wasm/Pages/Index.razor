@page "/"

<div class="gallery-page">
    <!-- Hero -->
    <div class="home-hero">
        <div class="home-hero__badge">
            <span>⚡</span> WinUI-style Blazor Components
        </div>
        <h1 class="home-hero__title">
            <span>Fluent.Blazor</span> Gallery
        </h1>
        <p class="home-hero__subtitle">
            An interactive showcase of all Fluent.Blazor components — each page mirrors the WinUI 3 Gallery
            with live demos, interactive options, and syntax-highlighted code samples.
        </p>
        <div class="home-hero__stats">
            <div class="home-stat">
                <span class="home-stat__number">39</span>
                <span class="home-stat__label">Components</span>
            </div>
            <div class="home-stat">
                <span class="home-stat__number">38</span>
                <span class="home-stat__label">Gallery Pages</span>
            </div>
            <div class="home-stat">
                <span class="home-stat__number">3</span>
                <span class="home-stat__label">Material Effects</span>
            </div>
        </div>
    </div>

    <!-- Primitives -->
    <div class="home-section">
        <div class="home-section__title">Primitives</div>
        <div class="control-grid">
            @foreach (var card in _primitiveCards)
            {
                <a class="control-card" href="@card.Route">
                    <div class="control-card__icon">@card.Icon</div>
                    <div class="control-card__name">@card.Name</div>
                    <div class="control-card__category">Primitives</div>
                </a>
            }
        </div>
    </div>

    <!-- Composite Controls -->
    <div class="home-section">
        <div class="home-section__title">Composite Controls</div>
        <div class="control-grid">
            @foreach (var card in _compositeCards)
            {
                <a class="control-card" href="@card.Route">
                    <div class="control-card__icon">@card.Icon</div>
                    <div class="control-card__name">@card.Name</div>
                    <div class="control-card__category">Composite</div>
                </a>
            }
        </div>
    </div>

    <!-- Effects & Materials -->
    <div class="home-section">
        <div class="home-section__title">Effects &amp; Materials</div>
        <div class="control-grid">
            @foreach (var card in _effectCards)
            {
                <a class="control-card" href="@card.Route">
                    <div class="control-card__icon">@card.Icon</div>
                    <div class="control-card__name">@card.Name</div>
                    <div class="control-card__category">Effects</div>
                </a>
            }
        </div>
    </div>
</div>

