@page "/controls/flyout"
@using Fluent.Blazor.Effects
@using Fluent.Blazor.Composite

<div class="gallery-page">
    <PageHeader Eyebrow="Composite Controls" Title="Flyout" Description="Flyouts show contextual information or request user confirmation." />

    <ControlExample HeaderText="Standard Click Triggered Flyout" RazorCode="@_flyRazor">
        <Example>
            <div class="demo-row">
                <FluentFlyout Placement="OverlayPlacement.Bottom">
                    <ChildContent>
                        <FluentButton Variant="ButtonVariant.Standard">Open Bottom Flyout</FluentButton>
                    </ChildContent>
                    <FlyoutContent>
                        <div style="padding: 4px;">
                            <FluentTextBlock Variant="TextBlockVariant.BodyStrong">Delete Confirmation</FluentTextBlock>
                            <FluentTextBlock Variant="TextBlockVariant.Body" style="margin-top:4px;">Are you sure? This cannot be undone.</FluentTextBlock>
                        </div>
                    </FlyoutContent>
                </FluentFlyout>
            </div>
        </Example>
    </ControlExample>

    <ControlExample HeaderText="Externally Controlled / Programmatic Open" RazorCode="@_externalRazor" CSharpCode="@_externalCs">
        <Example>
            <div class="demo-row" style="gap: 8px; align-items: center;">
                <FluentFlyout @bind-IsOpen="_flyoutOpen" Placement="OverlayPlacement.Right">
                    <ChildContent>
                        <FluentButton Variant="ButtonVariant.Standard">Externally Controlled Flyout</FluentButton>
                    </ChildContent>
                    <FlyoutContent>
                        <div style="padding: 4px;">
                            <FluentTextBlock Variant="TextBlockVariant.Body">Opened from the button on the right.</FluentTextBlock>
                            <div style="margin-top:12px;">
                                <FluentButton Variant="ButtonVariant.Accent" OnClick="@(() => _flyoutOpen = false)">Close</FluentButton>
                            </div>
                        </div>
                    </FlyoutContent>
                </FluentFlyout>
                
                <FluentButton Variant="ButtonVariant.Subtle" OnClick="@(() => _flyoutOpen = true)">Open from here</FluentButton>
            </div>
        </Example>
    </ControlExample>
</div>

@code {
    private bool _flyoutOpen;

    private const string _flyRazor = @"<FluentFlyout Placement=""OverlayPlacement.Bottom"">
    <ChildContent>
        <FluentButton Variant=""ButtonVariant.Standard"">Open Bottom Flyout</FluentButton>
    </ChildContent>
    <FlyoutContent>
        <div style=""padding: 4px;"">
            <FluentTextBlock Variant=""TextBlockVariant.BodyStrong"">Delete Confirmation</FluentTextBlock>
            <FluentTextBlock Variant=""TextBlockVariant.Body"" style=""margin-top:4px;"">Are you sure? This cannot be undone.</FluentTextBlock>
        </div>
    </FlyoutContent>
</FluentFlyout>";

    private const string _externalRazor = @"<FluentFlyout @bind-IsOpen=""_flyoutOpen"" Placement=""OverlayPlacement.Right"">
    <ChildContent>
        <FluentButton Variant=""ButtonVariant.Standard"">Externally Controlled Flyout</FluentButton>
    </ChildContent>
    <FlyoutContent>
        <div style=""padding: 4px;"">
            <FluentTextBlock Variant=""TextBlockVariant.Body"">Opened from the button on the right.</FluentTextBlock>
            <div style=""margin-top:12px;"">
                <FluentButton Variant=""ButtonVariant.Accent"" OnClick=""@(() => _flyoutOpen = false)"">Close</FluentButton>
            </div>
        </div>
    </FlyoutContent>
</FluentFlyout>

<FluentButton Variant=""ButtonVariant.Subtle"" OnClick=""@(() => _flyoutOpen = true)"">Open from here</FluentButton>";

    private const string _externalCs = @"private bool _flyoutOpen;";
}
