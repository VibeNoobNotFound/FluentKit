@page "/controls/contentdialog"
@using Fluent.Blazor.Composite

<div class="gallery-page">
    <PageHeader Eyebrow="Composite Controls" Title="ContentDialog" Description="Use ContentDialog to show modals and prompt for structured forms or operations." />

    <ControlExample HeaderText="ContentDialog Prompts" RazorCode="@_dialogRazor" CSharpCode="@_dialogCs">
        <Example>
            <div class="demo-row" style="gap: 8px;">
                <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => _basicOpen = true)">Basic Modal</FluentButton>
                <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => _confirmOpen = true)">Confirm Popup (Two Buttons)</FluentButton>
                <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => _unclosableOpen = true)">Not Closable (Max size)</FluentButton>
            </div>
            <div class="demo-output" style="margin-top: 12px; font-size: 12px; opacity: 0.8;">Action State: @_actionState</div>

            <FluentContentDialog @bind-IsOpen="_basicOpen" Title="About App">
                <FluentTextBlock Variant="TextBlockVariant.Body">
                    A basic Modal Dialog overlay box with default light dismiss behavior.
                </FluentTextBlock>
            </FluentContentDialog>

            <FluentContentDialog @bind-IsOpen="_confirmOpen" Title="Confirm Delete">
                <ChildContent>
                    <FluentTextBlock Variant="TextBlockVariant.Body">Are you sure you want to proceed? This action cannot be undone.</FluentTextBlock>
                </ChildContent>
                <Footer>
                    <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => CloseConfirm("Cancelled"))">Cancel</FluentButton>
                    <FluentButton Variant="ButtonVariant.Accent" OnClick="@(() => CloseConfirm("Confirmed"))">Delete</FluentButton>
                </Footer>
            </FluentContentDialog>

            <FluentContentDialog @bind-IsOpen="_unclosableOpen" Title="Processing Operation" Size="ContentDialogSize.Max" Closable="false">
                <ChildContent>
                    <FluentTextBlock Variant="TextBlockVariant.Body">
                        Escape and scrim-click are disabled here (Closable="false") — the only way out is the explicit button below.
                    </FluentTextBlock>
                </ChildContent>
                <Footer>
                    <FluentButton Variant="ButtonVariant.Standard" OnClick="@(() => CloseUnclosable())">Done</FluentButton>
                </Footer>
            </FluentContentDialog>
        </Example>
    </ControlExample>
</div>

@code {
    private bool _basicOpen;
    private bool _confirmOpen;
    private bool _unclosableOpen;
    private string? _actionState;

    private void CloseConfirm(string act)
    {
        _actionState = act;
        _confirmOpen = false;
    }

    private void CloseUnclosable()
    {
        _actionState = "Unclosable Completed";
        _unclosableOpen = false;
    }

    private const string _dialogRazor = @"<FluentButton Variant=""ButtonVariant.Standard"" OnClick=""@(() => _basicOpen = true)"">Basic Modal</FluentButton>
<FluentButton Variant=""ButtonVariant.Standard"" OnClick=""@(() => _confirmOpen = true)"">Confirm Popup (Two Buttons)</FluentButton>
<FluentButton Variant=""ButtonVariant.Standard"" OnClick=""@(() => _unclosableOpen = true)"">Not Closable (Max size)</FluentButton>

<FluentContentDialog @bind-IsOpen=""_basicOpen"" Title=""About App"">
    <FluentTextBlock Variant=""TextBlockVariant.Body"">
        A basic Modal Dialog overlay box with default light dismiss behavior.
    </FluentTextBlock>
</FluentContentDialog>

<FluentContentDialog @bind-IsOpen=""_confirmOpen"" Title=""Confirm Delete"">
    <ChildContent>
        <FluentTextBlock Variant=""TextBlockVariant.Body"">Are you sure you want to proceed? This action cannot be undone.</FluentTextBlock>
    </ChildContent>
    <Footer>
        <FluentButton Variant=""ButtonVariant.Standard"" OnClick=""@(() => CloseConfirm(""Cancelled""))"">Cancel</FluentButton>
        <FluentButton Variant=""ButtonVariant.Accent"" OnClick=""@(() => CloseConfirm(""Confirmed""))"">Delete</FluentButton>
    </Footer>
</FluentContentDialog>

<FluentContentDialog @bind-IsOpen=""_unclosableOpen"" Title=""Processing Operation"" Size=""ContentDialogSize.Max"" Closable=""false"">
    <ChildContent>
        <FluentTextBlock Variant=""TextBlockVariant.Body"">
            Escape and scrim-click are disabled here (Closable=""false"") — the only way out is the explicit button below.
        </FluentTextBlock>
    </ChildContent>
    <Footer>
        <FluentButton Variant=""ButtonVariant.Standard"" OnClick=""@(() => CloseUnclosable())"">Done</FluentButton>
    </Footer>
</FluentContentDialog>";

    private const string _dialogCs = @"private bool _basicOpen;
private bool _confirmOpen;
private bool _unclosableOpen;
private string? _actionState;

private void CloseConfirm(string act)
{
    _actionState = act;
    _confirmOpen = false;
}

private void CloseUnclosable()
{
    _actionState = ""Unclosable Completed"";
    _unclosableOpen = false;
}";
}
