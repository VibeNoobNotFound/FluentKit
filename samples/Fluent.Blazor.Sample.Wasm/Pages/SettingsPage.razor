@page "/settings"
@inject IThemeService ThemeService

<div class="gallery-page">
    <PageHeader Eyebrow="Get Started" Title="Settings"
                Description="Customize the gallery app appearance and view version information." />

    @* ── Personalization ──────────────────────────────────────────────── *@
    <div class="settings-group">
        <h2 class="settings-group__title">Personalization</h2>

        @* App theme *@
        <div class="settings-item">
            <div class="settings-item__icon">
                <FluentIcon Name="ic_fluent_paint_brush_20_regular" Size="20" />
            </div>
            <div class="settings-item__info">
                <span class="settings-item__label">App theme</span>
                <span class="settings-item__desc">Choose Light, Dark, or follow the system setting.</span>
            </div>
            <div class="demo-row">
                <FluentButton Variant="ButtonVariant.Standard"
                              OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Light))">
                    <FluentIcon Name="ic_fluent_weather_sunny_20_regular" Size="16" style="margin-right:6px;" />
                    Light
                </FluentButton>
                <FluentButton Variant="ButtonVariant.Standard"
                              OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.Dark))">
                    <FluentIcon Name="ic_fluent_weather_moon_20_regular" Size="16" style="margin-right:6px;" />
                    Dark
                </FluentButton>
                <FluentButton Variant="ButtonVariant.Standard"
                              OnClick="@(() => ThemeService.SetModeAsync(ThemeMode.System))">
                    <FluentIcon Name="ic_fluent_desktop_20_regular" Size="16" style="margin-right:6px;" />
                    System
                </FluentButton>
            </div>
        </div>

        @* Background material *@
        <div class="settings-item">
            <div class="settings-item__icon">
                <FluentIcon Name="ic_fluent_color_background_20_regular" Size="20" />
            </div>
            <div class="settings-item__info">
                <span class="settings-item__label">Background material</span>
                <span class="settings-item__desc">
                    <b>Mica</b> (Base) uses a soft wallpaper-tinted background. <b>Tabbed</b> (Mica Alt) applies stronger tinting for tab-style surfaces — the same material used on WinUI tabbed title bars.
                </span>
            </div>
            <FluentRadioGroup Value="@_bgVariantStr"
                              ValueChanged="@((object? v) => OnBgVariantChanged(v as string))">
                <div class="demo-row">
                    <FluentRadioButton Value='@("base")'>
                        <FluentIcon Name="ic_fluent_color_background_20_regular" Size="14" style="margin-right:4px;" />
                        Mica (Base)
                    </FluentRadioButton>
                    <FluentRadioButton Value='@("basealt")'>
                        <FluentIcon Name="ic_fluent_tabs_20_regular" Size="14" style="margin-right:4px;" />
                        Tabbed (Mica Alt)
                    </FluentRadioButton>
                </div>
            </FluentRadioGroup>
        </div>
    </div>

    @* ── About ────────────────────────────────────────────────────────── *@
    <div class="settings-group">
        <h2 class="settings-group__title">About</h2>

        <div class="settings-item">
            <div class="settings-item__icon">
                <FluentIcon Name="ic_fluent_info_20_regular" Size="20" />
            </div>
            <div class="settings-item__info">
                <span class="settings-item__label">Fluent.Blazor Gallery</span>
                <span class="settings-item__desc">v1.0.0 — A WinUI-style Blazor component gallery</span>
            </div>
        </div>

        <div class="settings-item">
            <div class="settings-item__icon">
                <FluentIcon Name="ic_fluent_open_20_regular" Size="20" />
            </div>
            <div class="settings-item__info">
                <span class="settings-item__label">Source code</span>
                <span class="settings-item__desc">MIT License — contributions welcome.</span>
            </div>
            <FluentButton Variant="ButtonVariant.Hyperlink" Href="https://github.com" Target="_blank">
                View on GitHub
            </FluentButton>
        </div>
    </div>
</div>

@code {
    private object? _bgVariantStr = MainLayout.BackgroundVariantSetting == MicaVariant.BaseAlt ? "basealt" : "base";

    private void OnBgVariantChanged(string? value)
    {
        _bgVariantStr = value;
        var variant = value == "basealt" ? MicaVariant.BaseAlt : MicaVariant.Base;
        MainLayout.SetBackgroundVariant(variant);
    }
}
