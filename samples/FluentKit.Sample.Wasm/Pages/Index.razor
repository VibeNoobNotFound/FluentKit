        new("ToggleSwitch",  "controls/toggleswitch",  "ic_fluent_toggle_left_20_regular"),
        new("ToggleButton",  "controls/togglebutton",  "ic_fluent_toggle_multiple_20_regular"),
        new("TextBox",       "controls/textbox",       "ic_fluent_text_field_20_regular"),
        new("PasswordBox",   "controls/passwordbox",   "ic_fluent_password_20_regular"),
        new("Slider",        "controls/slider",        "ic_fluent_options_20_regular"),
        new("ProgressBar",   "controls/progressbar",   "ic_fluent_status_20_regular"),
